DecodedInterpolation decode_bc6_mode30(uvec4 payload, int linear_pixel, int part, int anchor_pixel)
{
    ivec3 ep0, ep1;

    if (part != 0)
    {
        int r2 = extract_bits(payload, 65, 6);
        int g2 = extract_bits(payload, 41, 4) | (extract_bits(payload, 24, 1) << 4) | (extract_bits(payload, 21, 1) << 5);
        int b2 = extract_bits(payload, 61, 4) | (extract_bits(payload, 14, 1) << 4) | (extract_bits(payload, 22, 1) << 5);

        int r3 = extract_bits(payload, 71, 6);
        int g3 = extract_bits(payload, 51, 4) | (extract_bits(payload, 11, 1) << 4) | (extract_bits(payload, 31, 1) << 5);
        int b3 = extract_bits(payload, 12, 2) | (extract_bits(payload, 23, 1) << 2) |
                (extract_bits(payload, 32, 1) << 3) | (extract_bits(payload, 34, 1) << 4) | (extract_bits(payload, 33, 1) << 5);

        ep0 = ivec3(r2, g2, b2);
        ep1 = ivec3(r3, g3, b3);
    }
    else
    {
        int r0 = extract_bits(payload, 5, 6);
        int g0 = extract_bits(payload, 15, 6);
        int b0 = extract_bits(payload, 25, 6);

        int r1 = extract_bits(payload, 35, 6);
        int g1 = extract_bits(payload, 45, 6);
        int b1 = extract_bits(payload, 55, 6);

        ep0 = ivec3(r0, g0, b0);
        ep1 = ivec3(r1, g1, b1);
    }

    ep0 = unquantize_endpoint(ep0, 6);
    ep1 = unquantize_endpoint(ep1, 6);

    int index = extract_bits(
            payload,
            max(81 + linear_pixel * 3 - int(linear_pixel > anchor_pixel), 82),
            (linear_pixel == 0 || linear_pixel == anchor_pixel) ? 2 : 3);

    int w = weight_table3[index];
    return DecodedInterpolation(ep0, ep1, w);
}

#ifdef PANVK_BC_FS
void main()
{
    int format = registers.format;
#ifdef PANVK_BC_FS
    /* One invocation per texel of the render area starting at (x0, y0); the
     * layer comes from the layered rect draw. */
    int x = int(gl_FragCoord.x) - registers.x0;
    int y = int(gl_FragCoord.y) - registers.y0;
    int z = gl_Layer;
#else
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int z = int(gl_GlobalInvocationID.z);

    if (x >= registers.width || y >= registers.height || z >= registers.depth)
        return;
#endif

    ivec2 pixel_coord = ivec2(x, y) % 4;
    int linear_pixel = 4 * pixel_coord.y + pixel_coord.x;
    InBuf ibuf = InBuf(registers.src);
    OutBuf obuf = OutBuf(registers.dst);
    uint in_word = (uint(z) * registers.src_slice_B + uint(y / 4) * registers.src_row_B) / 4u;
    uint out_word = (uint(z) * registers.dst_slice_B + uint(y) * registers.dst_row_B) / 4u;

    uint w = in_word + uint(x / 4) * 4u;
    uvec4 payload = uvec4(ibuf.data[w], ibuf.data[w + 1u], ibuf.data[w + 2u], ibuf.data[w + 3u]);

    DecodedInterpolation interp;
    is_signed = (format == VK_FORMAT_BC6H_SFLOAT_BLOCK);

    int mode = extract_bits(payload, 0, 5);
    int part_index = extract_bits(payload, 77, 5);
    int part = (partition_table2[part_index] >> linear_pixel) & 1;
    int anchor_pixel = anchor_table2[part_index];

    if ((mode & 2) == 0)
    {
        if ((mode & 1) != 0)
            interp = decode_bc6_mode1(payload, linear_pixel, part, anchor_pixel);
        else
            interp = decode_bc6_mode0(payload, linear_pixel, part, anchor_pixel);
    }
    else
    {
        switch (mode)
        {
            case 2:
            interp = decode_bc6_mode2(payload, linear_pixel, part, anchor_pixel);
            break;
            case 3:
            interp = decode_bc6_mode3(payload, linear_pixel);
            break;
            case 6:
            interp = decode_bc6_mode6(payload, linear_pixel, part, anchor_pixel);
            break;
            case 7:
            interp = decode_bc6_mode7(payload, linear_pixel);
            break;
            case 10:
            interp = decode_bc6_mode10(payload, linear_pixel, part, anchor_pixel);
            break;
            case 11:
            interp = decode_bc6_mode11(payload, linear_pixel);
            break;
            case 14:
            interp = decode_bc6_mode14(payload, linear_pixel, part, anchor_pixel);
            break;
            case 15:
            interp = decode_bc6_mode15(payload, linear_pixel);
            break;
            case 18:
            interp = decode_bc6_mode18(payload, linear_pixel, part, anchor_pixel);
            break;
            case 22:
            interp = decode_bc6_mode22(payload, linear_pixel, part, anchor_pixel);
            break;
            case 26:
            interp = decode_bc6_mode26(payload, linear_pixel, part, anchor_pixel);
            break;
            case 30:
            interp = decode_bc6_mode30(payload, linear_pixel, part, anchor_pixel);
            break;
            default:
            interp = DecodedInterpolation(ivec3(0), ivec3(0), 0);
            break;
        }
    }

    ivec3 rgba_result = interpolate_endpoint(interp);

    // Squeeze range.
    if (is_signed)
    {
        ivec3 neg_result = 0x8000 | (((-rgba_result) * 31) >> 5);
        ivec3 pos_result = (rgba_result * 31) >> 5;
        rgba_result = mix(pos_result, neg_result, lessThan(rgba_result, ivec3(0)));

        // Fixup for -0.0. Seems to not be emitted by hardware decoder.
        rgba_result = mix(rgba_result, ivec3(0), equal(rgba_result, ivec3(0x8000)));
    }
    else
    {
        rgba_result = (rgba_result * 31) >> 6;
    }

    uint packed_rg = (uint(rgba_result.r) & 0xFFFFu) |
            (uint(rgba_result.g) & 0xFFFFu) << 16;
    uint packed_ba = (uint(rgba_result.b) & 0xFFFFu) |
            (0x3C00u << 16);
#ifdef PANVK_BC_FS
    o_color = vec4(unpackHalf2x16(packed_rg), unpackHalf2x16(packed_ba));
#else
    obuf.data[out_word + 2u * uint(x)] = packed_rg;
    obuf.data[out_word + 2u * uint(x) + 1u] = packed_ba;
#endif
}
#else /* compute: PANVK_BC_BLOCK or the linear block decode */

/* Endpoints of both subsets of a block: the per-texel decoders above at
 * texel 0 with part 0 and 1, so the endpoint arithmetic is the exact same
 * code. Their weight (texel 0's index) is not used. */
#define BC6_EPS(f) { s0 = f(payload, 0, 0, 15); s1 = f(payload, 0, 1, 15); }
#define BC6_EP1(f) { s0 = f(payload, 0); s1 = s0; }
void
bc6_block_endpoints(uvec4 payload, int mode, out DecodedInterpolation s0,
                    out DecodedInterpolation s1)
{
    if ((mode & 2) == 0)
    {
        if ((mode & 1) != 0)
            BC6_EPS(decode_bc6_mode1)
        else
            BC6_EPS(decode_bc6_mode0)
    }
    else
    {
        switch (mode)
        {
            case 2: BC6_EPS(decode_bc6_mode2) break;
            case 3: BC6_EP1(decode_bc6_mode3) break;
            case 6: BC6_EPS(decode_bc6_mode6) break;
            case 7: BC6_EP1(decode_bc6_mode7) break;
            case 10: BC6_EPS(decode_bc6_mode10) break;
            case 11: BC6_EP1(decode_bc6_mode11) break;
            case 14: BC6_EPS(decode_bc6_mode14) break;
            case 15: BC6_EP1(decode_bc6_mode15) break;
            case 18: BC6_EPS(decode_bc6_mode18) break;
            case 22: BC6_EPS(decode_bc6_mode22) break;
            case 26: BC6_EPS(decode_bc6_mode26) break;
            case 30: BC6_EPS(decode_bc6_mode30) break;
            default:
                s0 = DecodedInterpolation(ivec3(0), ivec3(0), 0);
                s1 = s0;
                break;
        }
    }
}

/* Round a positive half (no sign, below 0x7c00) to an unsigned float with
 * the same 5-bit exponent and 10 - s mantissa bits: round to nearest even,
 * saturating at the largest finite value (a finite texel never becomes
 * infinite). */
uint
half_to_uf(uint h, uint s, uint max_finite)
{
    return min((h + ((1u << (s - 1u)) - 1u) + ((h >> s) & 1u)) >> s, max_finite);
}

/* a + m0 * m1 for a 64-bit address a. */
uvec2
addr_mad(uvec2 a, uint m0, uint m1)
{
    uint hi, lo, c;
    umulExtended(m0, m1, hi, lo);
    a.x = uaddCarry(a.x, lo, c);
    a.y += hi + c;
    return a;
}

#ifdef PANVK_BC_BLOCK
void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (x >= registers.bw || y >= registers.bh)
        return;

    uvec2 sa = addr_mad(addr_mad(registers.src, z, registers.src_slice_B), y,
                        registers.src_row_B);
    uvec4 payload = In4(sa).data[x];

    /* Upload into a raw-store image: keep the BC blocks here instead of a
     * separate copy pass over the source (as csf-v11/203 does for ETC2). */
    if ((registers.raw.x | registers.raw.y) != 0u)
    {
        uvec2 ra = addr_mad(addr_mad(registers.raw, z, registers.raw_slice_B),
                            y, registers.raw_row_B);
        Out4(ra).data[x] = payload;
    }

    is_signed = XC_MODE == 9u;

    int mode = extract_bits(payload, 0, 5);
    int part_index = extract_bits(payload, 77, 5);
    /* Modes 3, 7, 11 and 15 have one subset and 4-bit indices from bit 65;
     * the others two subsets and 3-bit indices from bit 82. */
    bool one = mode == 3 || mode == 7 || mode == 11 || mode == 15;
    uint pmask = one ? 0u : uint(partition_table2[part_index]);
    int anchor = one ? 0 : anchor_table2[part_index];

    DecodedInterpolation s0, s1;
    bc6_block_endpoints(payload, mode, s0, s1);

    /* Index bits from the first index (bit 65 or 82), as 64 bits. Texel p
     * has k (4 or 3) bits at k p - 1 - (p > anchor), texel 0 and the anchor
     * one bit less. A one-subset block takes anchor 16 (none). */
    uint sh = one ? 1u : 18u;
    uvec2 st = uvec2((payload.z >> sh) | (payload.w << (32u - sh)),
                     payload.w >> sh);
    int k = one ? 4 : 3;
    if (one)
        anchor = 16;
    /* weight_table4 / weight_table3 = (idx wa + 16) >> 5, exact. */
    int wa = one ? 136 : 292;

    /* Block (bx, by) of the level: tile row by / 4, tile bx / 4, block
     * | by1 | bx1^by1 | by0 | bx0^by0 | in the tile; its 16 texels are 16
     * consecutive elements, texel (px, py) at | py1 | px1^py1 | py0 |
     * px0^py0 |: 4 (B10G11R11) or 8 (R16G16B16A16) uvec4s, written in that
     * order so only one uvec4 of results is live. */
    uint bx = registers.bx0 + x, by = registers.by0 + y;
    uint ix = bx & 3u, iy = by & 3u;
    uint in_tile = ((iy >> 1) << 3) | (((ix ^ iy) >> 1) << 2) |
                   ((iy & 1u) << 1) | ((ix ^ iy) & 1u);
    uvec2 da = addr_mad(addr_mad(registers.dst, z, registers.dst_slice_B),
                        by >> 2, registers.dst_row_B);
    const uint T = is_signed ? 8u : 4u;
    Out4 obuf = Out4(da);
    uint ob = (bx >> 2) * 16u * T + in_tile * T;

    uint o[4];
    [[unroll]] for (int slot = 0; slot < 16; slot++)
    {
        /* Texel of this slot (the slot formula is its own inverse in y). */
        int py = ((slot >> 2) & 2) | ((slot >> 1) & 1);
        int px = (((slot >> 1) & 2) | (slot & 1)) ^ py;
        int p = 4 * py + px;

        int off = p == 0 ? 0 : k * p - 1 - int(p > anchor);
        int nb = (p == 0 ? k - 1 : k) - int(p == anchor);
        uint lo = off < 32 ? st.x : st.y;
        uint hi = off < 32 ? st.y : 0u;
        uint r = uint(off) & 31u;
        uint v = (lo >> r) | ((hi << 1u) << (31u - r));
        int idx = int(v & ((1u << nb) - 1u));
        int w = (idx * wa + 16) >> 5;

        bool sub = ((pmask >> p) & 1u) != 0u;
        DecodedInterpolation interp = DecodedInterpolation(
            sub ? s1.ep0 : s0.ep0, sub ? s1.ep1 : s0.ep1, w);
        ivec3 rgba_result = interpolate_endpoint(interp);

        // Squeeze range.
        if (is_signed)
        {
            ivec3 neg_result = 0x8000 | (((-rgba_result) * 31) >> 5);
            ivec3 pos_result = (rgba_result * 31) >> 5;
            rgba_result = mix(pos_result, neg_result, lessThan(rgba_result, ivec3(0)));

            // Fixup for -0.0. Seems to not be emitted by hardware decoder.
            rgba_result = mix(rgba_result, ivec3(0), equal(rgba_result, ivec3(0x8000)));

            /* R16G16B16A16_SFLOAT, as the fragment variant's output. */
            o[(2 * slot) & 3] = (uint(rgba_result.r) & 0xFFFFu) |
                                ((uint(rgba_result.g) & 0xFFFFu) << 16);
            o[(2 * slot + 1) & 3] =
                (uint(rgba_result.b) & 0xFFFFu) | (0x3C00u << 16);
            if ((slot & 1) == 1)
                obuf.data[ob + uint(slot >> 1)] = uvec4(o[0], o[1], o[2], o[3]);
        }
        else
        {
            rgba_result = (rgba_result * 31) >> 6;

            uvec3 h = uvec3(rgba_result);
            o[slot & 3] = half_to_uf(h.r, 4u, 0x7bfu) |
                          (half_to_uf(h.g, 4u, 0x7bfu) << 11) |
                          (half_to_uf(h.b, 5u, 0x3dfu) << 22);
            if ((slot & 3) == 3)
                obuf.data[ob + uint(slot >> 2)] = uvec4(o[0], o[1], o[2], o[3]);
        }
    }
}
#else /* !PANVK_BC_BLOCK */
/* 117: linear decode, one invocation per 4x4 block: the endpoints of both
 * subsets once per block (bc6_block_endpoints()) and per-texel weights from
 * the index bits, as the PANVK_BC_BLOCK variant, written as R16G16B16A16
 * like the per-texel fragment variant (bit-identical). */
void main()
{
    int format = registers.format;
    int bx = int(gl_GlobalInvocationID.x);
    int by = int(gl_GlobalInvocationID.y);
    int z = int(gl_GlobalInvocationID.z);

    if (bx * 4 >= registers.width || by * 4 >= registers.height ||
        z >= registers.depth)
        return;

    InBuf ibuf = InBuf(registers.src);
    uint w = (uint(z) * registers.src_slice_B + uint(by) * registers.src_row_B) / 4u +
             uint(bx) * 4u;
    uvec4 payload = uvec4(ibuf.data[w], ibuf.data[w + 1u], ibuf.data[w + 2u], ibuf.data[w + 3u]);

    is_signed = (format == VK_FORMAT_BC6H_SFLOAT_BLOCK);

    int mode = extract_bits(payload, 0, 5);
    int part_index = extract_bits(payload, 77, 5);
    bool one = mode == 3 || mode == 7 || mode == 11 || mode == 15;
    uint pmask = one ? 0u : uint(partition_table2[part_index]);
    int anchor = one ? 16 : anchor_table2[part_index];

    DecodedInterpolation s0, s1;
    bc6_block_endpoints(payload, mode, s0, s1);

    uint sh = one ? 1u : 18u;
    uvec2 st = uvec2((payload.z >> sh) | (payload.w << (32u - sh)),
                     payload.w >> sh);
    int k = one ? 4 : 3;
    int wa = one ? 136 : 292;

    uint row_B = registers.dst_row_B;
    uvec2 dst = registers.dst;
    bool vec_ok = ((dst.x | row_B | registers.dst_slice_B) & 15u) == 0u;
    uint out_word = (uint(z) * registers.dst_slice_B + uint(by * 4) * row_B) / 4u +
                    uint(bx * 4) * 2u;
    OutBuf obuf = OutBuf(dst);
    Out4 obuf4 = Out4(dst);

    [[unroll]] for (int py = 0; py < 4; py++) {
        if (by * 4 + py >= registers.height)
            break;
        uint o[8];
        [[unroll]] for (int px = 0; px < 4; px++) {
            int p = 4 * py + px;
            int off = p == 0 ? 0 : k * p - 1 - int(p > anchor);
            int nb = (p == 0 ? k - 1 : k) - int(p == anchor);
            uint lo = off < 32 ? st.x : st.y;
            uint hi = off < 32 ? st.y : 0u;
            uint r = uint(off) & 31u;
            uint v = (lo >> r) | ((hi << 1u) << (31u - r));
            int idx = int(v & ((1u << nb) - 1u));
            int wt = (idx * wa + 16) >> 5;

            bool sub = ((pmask >> p) & 1u) != 0u;
            DecodedInterpolation interp = DecodedInterpolation(
                sub ? s1.ep0 : s0.ep0, sub ? s1.ep1 : s0.ep1, wt);
            ivec3 rgba_result = interpolate_endpoint(interp);

            // Squeeze range.
            if (is_signed)
            {
                ivec3 neg_result = 0x8000 | (((-rgba_result) * 31) >> 5);
                ivec3 pos_result = (rgba_result * 31) >> 5;
                rgba_result = mix(pos_result, neg_result, lessThan(rgba_result, ivec3(0)));

                // Fixup for -0.0. Seems to not be emitted by hardware decoder.
                rgba_result = mix(rgba_result, ivec3(0), equal(rgba_result, ivec3(0x8000)));
            }
            else
            {
                rgba_result = (rgba_result * 31) >> 6;
            }

            o[2 * px] = (uint(rgba_result.r) & 0xFFFFu) |
                        (uint(rgba_result.g) & 0xFFFFu) << 16;
            o[2 * px + 1] = (uint(rgba_result.b) & 0xFFFFu) | (0x3C00u << 16);
        }
        uint ow = out_word + uint(py) * (row_B / 4u);
        if (vec_ok && bx * 4 + 4 <= registers.width) {
            obuf4.data[ow / 4u] = uvec4(o[0], o[1], o[2], o[3]);
            obuf4.data[ow / 4u + 1u] = uvec4(o[4], o[5], o[6], o[7]);
        } else {
            [[unroll]] for (int px = 0; px < 4; px++) {
                if (bx * 4 + px < registers.width) {
                    obuf.data[ow + 2u * uint(px)] = o[2 * px];
                    obuf.data[ow + 2u * uint(px) + 1u] = o[2 * px + 1];
                }
            }
        }
    }
}
#endif
