    ep0 = unquantize_endpoint(ep0, 10);
    ep1 = unquantize_endpoint(ep1, 10);

    int index = extract_bits(
            payload,
            max(64 + linear_pixel * 4, 65),
            linear_pixel == 0 ? 3 : 4);

