   0x33333333u, 0x6a6a3333u, 0x6a6a6a6au, 0x6a6a6a6au, 0x6a6a6a6au, 0x71716a6au, 0x78787171u, 0x84787878u,
   0x8d848484u, 0x968d8d8du, 0x96969696u, 0x96969696u, 0x96969696u, 0xcf969696u, 0xcfcfcfcfu, 0xcfcfcfcfu,
   0xcfcfcfcfu, 0xcfcfcfcfu, 0xcfcfcfcfu, 0xcfcfcfcfu, 0xcfcfcfcfu, 0xcfcfcfcfu, 0xcfcfcfcfu, 0xcfcfcfcfu,
   0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x42423b3bu,
   0x42424242u, 0x51515151u, 0x51515151u, 0x60606060u, 0x60606060u, 0x60606060u, 0x60606060u, 0x9c606060u,
   0x9c9c9c9cu, 0x9c9c9c9cu, 0x9c9c9c9cu, 0x9c9c9c9cu, 0xadadad9cu, 0xadadadadu, 0xbebebeadu, 0xc7bebebeu,
   0xc7c7c7c7u, 0xc7c7c7c7u, 0xc7c7c7c7u, 0xc7c7c7c7u, 0xc7c7c7c7u, 0xc7c7c7c7u, 0xc7c7c7c7u, 0xc7c7c7c7u,
   0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu, 0x3b3b3b3bu,
   0x4a4a4a4au, 0x4a4a4a4au, 0x59595959u, 0x59595959u, 0x68686868u, 0x68686868u, 0x68686868u, 0x94686868u,
   0x94949494u, 0x94949494u, 0x94949494u, 0xa5a5a594u, 0xa5a5a5a5u, 0xb6b6b6a5u, 0xb6b6b6b6u, 0xc7c7c7b6u,
