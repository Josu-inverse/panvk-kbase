/* Results of the helpers (no out parameters, see above). */
GLOBAL uint g_w0;
GLOBAL uint g_w1;
GLOBAL int g_sub_t;
GLOBAL uint g_sub_map;  /* ETC index of palette colour k at bits 2k */
GLOBAL int g_eac_base;
GLOBAL uint g_eac_map;  /* EAC index of palette entry k at bits 4k */
GLOBAL bool g_exact;    /* the ETC2 error returned is exact (not planar) */
GLOBAL uint g_out0;
GLOBAL uint g_out1;
GLOBAL uint g_out2;
GLOBAL uint g_out3;

int
rnd(float x)
{
   return I(floor(x + 0.5));
}

int
sq(int x)
{
   return x * x;
}

int
clamp255(int x)
{
   return clamp(x, 0, 255);
}

uint
bswap32(uint v)
{
   return (v >> 24) | ((v >> 8) & 0xff00u) | ((v << 8) & 0xff0000u) |
          (v << 24);
}

/* ======================= BC1 palette, ETC2 RGB ======================= */

/* BC1 palette colours (one int per channel) and indices (texel p = 4y + x
 * at bits 2p). g_grp bit k: colour k is on the endpoint 1 side (H seed);
 * g_c3t: colour 3 is the transparent black of 3-colour blocks. */
GLOBAL int g_r0;
GLOBAL int g_g0;
GLOBAL int g_b0;
GLOBAL int g_r1;
GLOBAL int g_g1;
GLOBAL int g_b1;
GLOBAL int g_r2;
GLOBAL int g_g2;
GLOBAL int g_b2;
GLOBAL int g_r3;
GLOBAL int g_g3;
GLOBAL int g_b3;
GLOBAL uint g_ci;
GLOBAL uint g_grp;
/* The palette as floats: the error sums below are exact in fp32 (at most
 * 16 * 3 * 255^2 < 2^24) and run on the FMA unit. */
GLOBAL float g_fr0;
GLOBAL float g_fg0;
GLOBAL float g_fb0;
GLOBAL float g_fr1;
GLOBAL float g_fg1;
GLOBAL float g_fb1;
GLOBAL float g_fr2;
GLOBAL float g_fg2;
GLOBAL float g_fb2;
GLOBAL float g_fr3;
GLOBAL float g_fg3;
GLOBAL float g_fb3;
GLOBAL bool g_c3t;

/* Texel masks (bit 2p) of the half blocks and of the rows / columns. */
#define HM_L 0x05050505u /* x < 2: subblock 0 of flip 0 */
#define HM_R 0x50505050u
#define HM_T 0x00005555u /* y < 2: subblock 0 of flip 1 */
#define HM_B 0x55550000u
#define HM_ALL 0x55555555u

int
pal_r(int k)
{
   return k == 0 ? g_r0 : (k == 1 ? g_r1 : (k == 2 ? g_r2 : g_r3));
}

int
pal_g(int k)
{
   return k == 0 ? g_g0 : (k == 1 ? g_g1 : (k == 2 ? g_g2 : g_g3));
}

int
pal_b(int k)
{
   return k == 0 ? g_b0 : (k == 1 ? g_b1 : (k == 2 ? g_b2 : g_b3));
}

int
rgb_err(int r, int g, int b, int qr, int qg, int qb)
{
   return sq(r - qr) + sq(g - qg) + sq(b - qb);
}

/* Texels (bit 2p) that use palette colour k. */
uint
pal_mask(int k)
{
   uint lo = g_ci & HM_ALL;
   uint hi = (g_ci >> 1) & HM_ALL;
   uint m = ((k & 1) != 0) ? lo : (~lo & HM_ALL);
   return m & (((k & 2) != 0) ? hi : (~hi & HM_ALL));
}

int
pal_n(int k, uint hm)
{
   return bitCount(pal_mask(k) & hm);
}

/* Bit 2p -> bit p. */
uint
compact_even(uint x)
{
   x &= HM_ALL;
   x = (x | (x >> 1)) & 0x33333333u;
   x = (x | (x >> 2)) & 0x0f0f0f0fu;
   x = (x | (x >> 4)) & 0x00ff00ffu;
   x = (x | (x >> 8)) & 0x0000ffffu;
   return x;
}

/* Bit 4y + x -> bit 4x + y. */
uint
transpose4(uint x)
{
   uint t = (x ^ (x >> 3)) & 0x0a0au;
   x = x ^ t ^ (t << 3);
   t = (x ^ (x >> 6)) & 0x00ccu;
   x = x ^ t ^ (t << 6);
   return x;
}

/* ETC1 index word from the index bit planes (texel bit 2p): the MSB plane
 * at bit 16 + (4x + y), the LSB plane at bit 4x + y, big-endian. */
uint
etc_pack_planes(uint lsb, uint msb)
{
   return bswap32((transpose4(compact_even(msb)) << 16) |
                  transpose4(compact_even(lsb)));
}

/* Index plane 'bit' of the texels in hm whose colour k has ETC index
 * (map >> 2k) & 3. */
uint
etc_plane(uint map, uint hm, uint bit)
{
   uint v = 0u;
   UNROLL for (int k = 0; k < 4; k++)
      v |= ((map >> U(2 * k)) & bit) != 0u ? pal_mask(k) : 0u;
   return v & hm;
}

float
fpal_r(int k)
{
   return k == 0 ? g_fr0 : (k == 1 ? g_fr1 : (k == 2 ? g_fr2 : g_fr3));
}

float
fpal_g(int k)
{
   return k == 0 ? g_fg0 : (k == 1 ? g_fg1 : (k == 2 ? g_fg2 : g_fg3));
}

float
fpal_b(int k)
{
   return k == 0 ? g_fb0 : (k == 1 ? g_fb1 : (k == 2 ? g_fb2 : g_fb3));
}

float
frgb_err4(float r, float g, float b, float qr, float qg, float qb)
{
   float dr = r - qr, dg = g - qg, db = b - qb;
   return 4.0 * (dr * dr + dg * dg + db * db);
}

/* Nearest of the 4 colours q0..q3 to palette colour k: 4 err + idx (exact
 * in fp32; ties keep the lower index). no2: index 2 is not available
 * (RGB8A1 transparent). */
float
etc_near(int k, float q0r, float q0g, float q0b, float q1r, float q1g,
         float q1b, float q2r, float q2g, float q2b, float q3r, float q3g,
         float q3b, bool no2)
{
   float r = fpal_r(k), g = fpal_g(k), b = fpal_b(k);
   float e0 = frgb_err4(r, g, b, q0r, q0g, q0b);
   float e1 = frgb_err4(r, g, b, q1r, q1g, q1b) + 1.0;
   float e2 = no2 ? 1e30 : frgb_err4(r, g, b, q2r, q2g, q2b) + 2.0;
   float e3 = frgb_err4(r, g, b, q3r, q3g, q3b) + 3.0;
   return min(min(e0, e1), min(e2, e3));
}

/* Error and index of an etc_near() result. */
float
near_err(float p)
{
   return floor(p * 0.25);
}

uint
near_idx(float p)
{
   return U(I(p)) & 3u;
}

/* Luma offset (x3) of colour k from a base: what the ETC1 modifiers, which
 * move all three channels, can follow. */
float
etc_u(int k, int br, int bg, int bb)
{
   float u = fpal_r(k) + fpal_g(k) + fpal_b(k) - F(br + bg + bb);
   return u < 0.0 ? -u : u;
}

/* Exact error of ETC1 table t around (br, bg, bb) over the palette colours
 * weighted by n0..n3; sets g_sub_map. */
int
etc_sub_exact(int t, int br, int bg, int bb, bool punch, int n0, int n1,
              int n2, int n3)
{
   float a = punch ? 0.0 : F(ETC1_A[t]), b = F(ETC1_B[t]);
   float fr = F(br), fg = F(bg), fb = F(bb);
   float q0r = clamp(fr + a, 0.0, 255.0), q0g = clamp(fg + a, 0.0, 255.0),
         q0b = clamp(fb + a, 0.0, 255.0);
   float q1r = clamp(fr + b, 0.0, 255.0), q1g = clamp(fg + b, 0.0, 255.0),
         q1b = clamp(fb + b, 0.0, 255.0);
   float q2r = clamp(fr - a, 0.0, 255.0), q2g = clamp(fg - a, 0.0, 255.0),
         q2b = clamp(fb - a, 0.0, 255.0);
   float q3r = clamp(fr - b, 0.0, 255.0), q3g = clamp(fg - b, 0.0, 255.0),
         q3b = clamp(fb - b, 0.0, 255.0);
   float r0 = etc_near(0, q0r, q0g, q0b, q1r, q1g, q1b, q2r, q2g, q2b, q3r, q3g, q3b, punch);
   float r1 = etc_near(1, q0r, q0g, q0b, q1r, q1g, q1b, q2r, q2g, q2b, q3r, q3g, q3b, punch);
   float r2 = etc_near(2, q0r, q0g, q0b, q1r, q1g, q1b, q2r, q2g, q2b, q3r, q3g, q3b, punch);
   float r3 = etc_near(3, q0r, q0g, q0b, q1r, q1g, q1b, q2r, q2g, q2b, q3r, q3g, q3b, punch);
   /* RGB8A1: colour 3 of a transparent block is index 2 (n3 is 0). */
   uint i3 = punch ? 2u : near_idx(r3);
   g_sub_map = near_idx(r0) | (near_idx(r1) << 2) | (near_idx(r2) << 4) | (i3 << 6);
   return I(F(n0) * near_err(r0) + F(n1) * near_err(r1) + F(n2) * near_err(r2) +
            (punch ? 0.0 : F(n3) * near_err(r3)));
}

/* 1D error of table t: modifier m moves the luma (x3) by 3m. */
float
fsq(float x)
{
   return x * x;
}

float
etc_tab_err(int t, bool punch, float n0, float u0, float n1, float u1,
            float n2, float u2, float n3, float u3)
{
   float a3 = punch ? 0.0 : F(3 * ETC1_A[t]), b3 = F(3 * ETC1_B[t]);
   return n0 * min(fsq(u0 - a3), fsq(u0 - b3)) + n1 * min(fsq(u1 - a3), fsq(u1 - b3)) +
          n2 * min(fsq(u2 - a3), fsq(u2 - b3)) + n3 * min(fsq(u3 - a3), fsq(u3 - b3));
}

/* Largest luma offset (x3) at which table t is the best for one colour:
 * 3 (b_t + b_t+1) / 2. */
CARR(int, ETC1_UTH, 7) 37, 69, 106, 153, 210, 279, 433 CEND

/* Best ETC1 table and indices for the texels of hm (minus tm) around base
 * colour (br, bg, bb). punch: RGB8A1 with the opaque bit clear (index 2 is
 * transparent, the small modifiers are 0). The table comes from a 1D search
 * on the luma offsets over the 3 tables around the one that fits the
 * farthest colour (all 8 with OPT_TAB8), then the indices exactly. */
int
etc_sub(uint hm, uint tm, int br, int bg, int bb, bool punch, uint opts)
{
   uint m = hm & ~tm;
   int n0 = pal_n(0, m), n1 = pal_n(1, m), n2 = pal_n(2, m), n3 = pal_n(3, m);
   float f0 = F(n0), f1 = F(n1), f2 = F(n2), f3 = F(n3);
   float u0 = etc_u(0, br, bg, bb), u1 = etc_u(1, br, bg, bb);
   float u2 = etc_u(2, br, bg, bb), u3 = etc_u(3, br, bg, bb);

   int bt = 0;
   if ((opts & OPT_TAB8) != 0u) {
      float best = 1e30;
      UNROLL for (int t = 0; t < 8; t++) {
         float e = etc_tab_err(t, punch, f0, u0, f1, u1, f2, u2, f3, u3);
         if (e < best) { best = e; bt = t; }
      }
   } else {
      float umax = max(max(n0 != 0 ? u0 : 0.0, n1 != 0 ? u1 : 0.0),
                       max(n2 != 0 ? u2 : 0.0, n3 != 0 ? u3 : 0.0));
      int t0 = 0;
      UNROLL for (int t = 0; t < 7; t++)
         t0 += umax > F(ETC1_UTH[t]) ? 1 : 0;
      t0 = clamp(t0, 1, 6);
      float e0 = etc_tab_err(t0 - 1, punch, f0, u0, f1, u1, f2, u2, f3, u3);
      float e1 = etc_tab_err(t0, punch, f0, u0, f1, u1, f2, u2, f3, u3);
      float e2 = etc_tab_err(t0 + 1, punch, f0, u0, f1, u1, f2, u2, f3, u3);
      bt = e0 <= e1 ? (e0 <= e2 ? t0 - 1 : t0 + 1) : (e1 <= e2 ? t0 : t0 + 1);
   }

   g_sub_t = bt;
   return etc_sub_exact(bt, br, bg, bb, punch, n0, n1, n2, n3);
}

/* Colour sums of the texels of mask m. */
int
sum_r(uint m)
{
   return pal_n(0, m) * g_r0 + pal_n(1, m) * g_r1 + pal_n(2, m) * g_r2 +
          pal_n(3, m) * g_r3;
}

int
sum_g(uint m)
{
   return pal_n(0, m) * g_g0 + pal_n(1, m) * g_g1 + pal_n(2, m) * g_g2 +
          pal_n(3, m) * g_g3;
}

int
sum_b(uint m)
{
   return pal_n(0, m) * g_b0 + pal_n(1, m) * g_b1 + pal_n(2, m) * g_b2 +
          pal_n(3, m) * g_b3;
}

/* Differential (or individual) mode with the given flip, from the colour
 * sums and texel counts of its two halves. Writes g_w0/g_w1. */
int
etc_try_flip(int flip, bool punch_fmt, bool transparent, uint tm, float sr0,
             float sg0, float sb0, float n0, float sr1, float sg1, float sb1,
             float n1, uint opts)
{
   uint h0 = flip != 0 ? HM_T : HM_L;
   uint h1 = flip != 0 ? HM_B : HM_R;

   /* 5-bit endpoints and their delta. */
   int r0 = clamp(rnd(sr0 * 31.0 / (255.0 * n0)), 0, 31);
   int g0 = clamp(rnd(sg0 * 31.0 / (255.0 * n0)), 0, 31);
   int b0 = clamp(rnd(sb0 * 31.0 / (255.0 * n0)), 0, 31);
   int r1 = clamp(rnd(sr1 * 31.0 / (255.0 * n1)), 0, 31);
   int g1 = clamp(rnd(sg1 * 31.0 / (255.0 * n1)), 0, 31);
   int b1 = clamp(rnd(sb1 * 31.0 / (255.0 * n1)), 0, 31);
   int dr = r1 - r0, dg = g1 - g0, db = b1 - b0;
   bool fits = dr >= -4 && dr <= 3 && dg >= -4 && dg <= 3 && db >= -4 &&
               db <= 3;
   bool diff = fits || punch_fmt;

   uint b0w, b1w, b2w;
   int er0, eg0, eb0, er1, eg1, eb1;
   if (diff) {
      dr = clamp(dr, -4, 3);
      dg = clamp(dg, -4, 3);
      db = clamp(db, -4, 3);
      r1 = r0 + dr; g1 = g0 + dg; b1 = b0 + db;
      er0 = (r0 << 3) | (r0 >> 2); eg0 = (g0 << 3) | (g0 >> 2);
      eb0 = (b0 << 3) | (b0 >> 2);
      er1 = (r1 << 3) | (r1 >> 2); eg1 = (g1 << 3) | (g1 >> 2);
      eb1 = (b1 << 3) | (b1 >> 2);
      b0w = U((r0 << 3) | (dr & 7));
      b1w = U((g0 << 3) | (dg & 7));
      b2w = U((b0 << 3) | (db & 7));
   } else {
      int ir0 = clamp(rnd(sr0 * 15.0 / (255.0 * n0)), 0, 15);
      int ig0 = clamp(rnd(sg0 * 15.0 / (255.0 * n0)), 0, 15);
      int ib0 = clamp(rnd(sb0 * 15.0 / (255.0 * n0)), 0, 15);
      int ir1 = clamp(rnd(sr1 * 15.0 / (255.0 * n1)), 0, 15);
      int ig1 = clamp(rnd(sg1 * 15.0 / (255.0 * n1)), 0, 15);
      int ib1 = clamp(rnd(sb1 * 15.0 / (255.0 * n1)), 0, 15);
      er0 = ir0 * 17; eg0 = ig0 * 17; eb0 = ib0 * 17;
      er1 = ir1 * 17; eg1 = ig1 * 17; eb1 = ib1 * 17;
      b0w = U((ir0 << 4) | ir1);
      b1w = U((ig0 << 4) | ig1);
      b2w = U((ib0 << 4) | ib1);
   }

   int err = etc_sub(h0, tm, er0, eg0, eb0, transparent, opts);
   int t0 = g_sub_t;
   uint map0 = g_sub_map;
   err += etc_sub(h1, tm, er1, eg1, eb1, transparent, opts);
   int t1 = g_sub_t;
   uint map1 = g_sub_map;

   /* Bit 1 of byte 3 is the diff bit, or the opaque bit for RGB8A1. */
   uint dbit = punch_fmt ? (transparent ? 0u : 2u) : (diff ? 2u : 0u);
   uint b3w = (U(t0) << 5) | (U(t1) << 2) | dbit | U(flip);

   g_w0 = b0w | (b1w << 8) | (b2w << 16) | (b3w << 24);
   g_w1 = etc_pack_planes(etc_plane(map0, h0, 1u) | etc_plane(map1, h1, 1u),
                          etc_plane(map0, h0, 2u) | etc_plane(map1, h1, 2u));
   return err;
}

/* Byte whose (top5 + lut[low3]) must stay in 0..31: only an underflow is
 * possible with bit 7 clear, and setting bit 7 fixes it. */
uint
etc_no_overflow(uint byte_v)
{
   int s = I(byte_v >> 3) + ETC_DIFF_LUT[byte_v & 7u];
   return s < 0 ? (byte_v | 0x80u) : byte_v;
}

/* Byte with bits 7..5 and 2 free whose (top5 + lut[low3]) must leave
 * 0..31, which selects the H (G byte) or planar (B byte) mode. */
uint
etc_force_overflow(uint byte_v)
{
   uint v1 = (byte_v >> 3) & 3u, v2 = byte_v & 3u;
   return (v1 + v2 < 4u) ? (byte_v | 0x04u) : (byte_v | 0xe0u);
}

/* Largest luma offset (x3) for H distance i: 3 (d_i + d_i+1) / 2. */
CARR(int, ETC_H_UTH, 7) 13, 25, 40, 58, 82, 109, 157 CEND

/* H mode: two 444 base colours +- a distance, seeded by the BC colour
 * groups (endpoint 0 side, endpoint 1 side). The distance comes from a 1D
 * search on the luma offsets of the colours from their group base, over
 * the 3 distances around the one of their weighted mean offset. */
int
etc_try_h(int n0, int n1, int n2, int n3)
{
   bool g0 = (g_grp & 1u) != 0u, g1 = (g_grp & 2u) != 0u;
   bool g2 = (g_grp & 4u) != 0u, g3 = (g_grp & 8u) != 0u;
   int w00 = g0 ? 0 : n0, w01 = g1 ? 0 : n1, w02 = g2 ? 0 : n2, w03 = g3 ? 0 : n3;
   int w10 = n0 - w00, w11 = n1 - w01, w12 = n2 - w02, w13 = n3 - w03;
   int na = w00 + w01 + w02 + w03, nb = w10 + w11 + w12 + w13;
   if (na == 0 || nb == 0)
      return BIG_ERR;

   float fa = 15.0 / (255.0 * F(na)), fb = 15.0 / (255.0 * F(nb));
   int q0r = clamp(rnd(F(w00 * g_r0 + w01 * g_r1 + w02 * g_r2 + w03 * g_r3) * fa), 0, 15);
   int q0g = clamp(rnd(F(w00 * g_g0 + w01 * g_g1 + w02 * g_g2 + w03 * g_g3) * fa), 0, 15);
   int q0b = clamp(rnd(F(w00 * g_b0 + w01 * g_b1 + w02 * g_b2 + w03 * g_b3) * fa), 0, 15);
   int q1r = clamp(rnd(F(w10 * g_r0 + w11 * g_r1 + w12 * g_r2 + w13 * g_r3) * fb), 0, 15);
   int q1g = clamp(rnd(F(w10 * g_g0 + w11 * g_g1 + w12 * g_g2 + w13 * g_g3) * fb), 0, 15);
   int q1b = clamp(rnd(F(w10 * g_b0 + w11 * g_b1 + w12 * g_b2 + w13 * g_b3) * fb), 0, 15);
   int v0 = (q0r << 8) | (q0g << 4) | q0b;
   int v1 = (q1r << 8) | (q1g << 4) | q1b;
   if (v0 == v1)
      return BIG_ERR;

   /* Luma offset (x3) of every colour from its group base. */
   int ar = q0r * 17, ag = q0g * 17, ab = q0b * 17;
   int cr = q1r * 17, cg = q1g * 17, cb = q1b * 17;
   float u0 = g0 ? etc_u(0, cr, cg, cb) : etc_u(0, ar, ag, ab);
   float u1 = g1 ? etc_u(1, cr, cg, cb) : etc_u(1, ar, ag, ab);
   float u2 = g2 ? etc_u(2, cr, cg, cb) : etc_u(2, ar, ag, ab);
   float u3 = g3 ? etc_u(3, cr, cg, cb) : etc_u(3, ar, ag, ab);
   float f0 = F(n0), f1 = F(n1), f2 = F(n2), f3 = F(n3);
   /* Integer division by 16 of a non-negative sum: floor. */
   float um = floor((f0 * u0 + f1 * u1 + f2 * u2 + f3 * u3) * (1.0 / 16.0));
   int i0 = 0;
   UNROLL for (int i = 0; i < 7; i++)
      i0 += um > F(ETC_H_UTH[i]) ? 1 : 0;
   i0 = clamp(i0, 1, 6);
   float best = 1e30;
   int di = 0;
   UNROLL for (int j = -1; j <= 1; j++) {
      float d3 = F(3 * ETC_H_DIST[i0 + j]);
      float e = f0 * fsq(u0 - d3) + f1 * fsq(u1 - d3) + f2 * fsq(u2 - d3) +
                f3 * fsq(u3 - d3);
      if (e < best) { best = e; di = i0 + j; }
   }

   /* The distance LSB is (colour 1 >= colour 2): swap to match it. */
   bool swap = (di & 1) != ((v0 >= v1) ? 1 : 0);
   int d = ETC_H_DIST[di];
   int sr = swap ? cr : ar, sg = swap ? cg : ag, sb = swap ? cb : ab;
   int tr = swap ? ar : cr, tg = swap ? ag : cg, tb = swap ? ab : cb;
   float p0r = F(clamp255(sr + d)), p0g = F(clamp255(sg + d)), p0b = F(clamp255(sb + d));
   float p1r = F(clamp255(sr - d)), p1g = F(clamp255(sg - d)), p1b = F(clamp255(sb - d));
   float p2r = F(clamp255(tr + d)), p2g = F(clamp255(tg + d)), p2b = F(clamp255(tb + d));
   float p3r = F(clamp255(tr - d)), p3g = F(clamp255(tg - d)), p3b = F(clamp255(tb - d));
   float r0 = etc_near(0, p0r, p0g, p0b, p1r, p1g, p1b, p2r, p2g, p2b, p3r, p3g, p3b, false);
   float r1 = etc_near(1, p0r, p0g, p0b, p1r, p1g, p1b, p2r, p2g, p2b, p3r, p3g, p3b, false);
   float r2 = etc_near(2, p0r, p0g, p0b, p1r, p1g, p1b, p2r, p2g, p2b, p3r, p3g, p3b, false);
   float r3 = etc_near(3, p0r, p0g, p0b, p1r, p1g, p1b, p2r, p2g, p2b, p3r, p3g, p3b, false);
   int err = I(f0 * near_err(r0) + f1 * near_err(r1) + f2 * near_err(r2) +
               f3 * near_err(r3));
   uint map = near_idx(r0) | (near_idx(r1) << 2) | (near_idx(r2) << 4) |
              (near_idx(r3) << 6);

   uint r1q = U(swap ? q1r : q0r), g1q = U(swap ? q1g : q0g),
        b1q = U(swap ? q1b : q0b);
   uint r2q = U(swap ? q0r : q1r), g2q = U(swap ? q0g : q1g),
        b2q = U(swap ? q0b : q1b);
   uint dib = U(di);

   uint b0w = (r1q << 3) | (g1q >> 1);
   uint b1w = ((g1q & 1u) << 4) | (b1q & 8u) | ((b1q >> 1) & 3u);
   uint b2w = ((b1q & 1u) << 7) | (r2q << 3) | (g2q >> 1);
   uint b3w = ((g2q & 1u) << 7) | (b2q << 3) | (((dib >> 2) & 1u) << 2) | 2u |
              ((dib >> 1) & 1u);

   b0w = etc_no_overflow(b0w);
   b1w = etc_force_overflow(b1w);

   g_w0 = b0w | (b1w << 8) | (b2w << 16) | (b3w << 24);
   g_w1 = etc_pack_planes(etc_plane(map, HM_ALL, 1u), etc_plane(map, HM_ALL, 2u));
   return err;
}

/* Planar mode: least-squares plane per channel, O/H/V in 676. */
int
etc_planar_q(float v, int maxq)
{
   return clamp(rnd(v * F(maxq) / 255.0), 0, maxq);
}

/* Sum of (2x - 3) (columns) or (2y - 3) (rows) over the texels of m. */
int
pos_x2(uint m)
{
   return -3 * bitCount(m & 0x01010101u) - bitCount(m & 0x04040404u) +
          bitCount(m & 0x10101010u) + 3 * bitCount(m & 0x40404040u);
}

int
pos_y2(uint m)
{
   return -3 * bitCount(m & 0x00000055u) - bitCount(m & 0x00005500u) +
          bitCount(m & 0x00550000u) + 3 * bitCount(m & 0x55000000u);
}

/* Planar error estimate: residual of the least-squares plane plus the
 * expected 676 quantization error; the planar block is chosen on it. */
#define PLANAR_Q_ERR 24.0

int
etc_try_planar(int n0i, int n1i, int n2i, int n3i)
{
   uint m0 = pal_mask(0), m1 = pal_mask(1), m2 = pal_mask(2), m3 = pal_mask(3);
   float n0 = F(n0i), n1 = F(n1i), n2 = F(n2i), n3 = F(n3i);
   float x0 = F(pos_x2(m0)), x1 = F(pos_x2(m1)), x2 = F(pos_x2(m2)), x3 = F(pos_x2(m3));
   float y0 = F(pos_y2(m0)), y1 = F(pos_y2(m1)), y2 = F(pos_y2(m2)), y3 = F(pos_y2(m3));
   float r0 = F(g_r0), r1 = F(g_r1), r2 = F(g_r2), r3 = F(g_r3);
   float gg0 = F(g_g0), gg1 = F(g_g1), gg2 = F(g_g2), gg3 = F(g_g3);
   float bb0 = F(g_b0), bb1 = F(g_b1), bb2 = F(g_b2), bb3 = F(g_b3);

   float mr = n0 * r0 + n1 * r1 + n2 * r2 + n3 * r3;
   float mg = n0 * gg0 + n1 * gg1 + n2 * gg2 + n3 * gg3;
   float mb = n0 * bb0 + n1 * bb1 + n2 * bb2 + n3 * bb3;
   float xr = 0.5 * (x0 * r0 + x1 * r1 + x2 * r2 + x3 * r3);
   float xg = 0.5 * (x0 * gg0 + x1 * gg1 + x2 * gg2 + x3 * gg3);
   float xb = 0.5 * (x0 * bb0 + x1 * bb1 + x2 * bb2 + x3 * bb3);
   float yr = 0.5 * (y0 * r0 + y1 * r1 + y2 * r2 + y3 * r3);
   float yg = 0.5 * (y0 * gg0 + y1 * gg1 + y2 * gg2 + y3 * gg3);
   float yb = 0.5 * (y0 * bb0 + y1 * bb1 + y2 * bb2 + y3 * bb3);
   float ss = n0 * (r0 * r0 + gg0 * gg0 + bb0 * bb0) +
              n1 * (r1 * r1 + gg1 * gg1 + bb1 * bb1) +
              n2 * (r2 * r2 + gg2 * gg2 + bb2 * bb2) +
              n3 * (r3 * r3 + gg3 * gg3 + bb3 * bb3);

   /* c(x, y) = a + bx x + by y; sum (x - 1.5)^2 over the block is 20. */
   float bxr = xr / 20.0, bxg = xg / 20.0, bxb = xb / 20.0;
   float byr = yr / 20.0, byg = yg / 20.0, byb = yb / 20.0;
   float ar = mr / 16.0 - 1.5 * (bxr + byr);
   float ag = mg / 16.0 - 1.5 * (bxg + byg);
   float ab = mb / 16.0 - 1.5 * (bxb + byb);
   float res = ss - (mr * mr + mg * mg + mb * mb) / 16.0 -
               (xr * xr + xg * xg + xb * xb + yr * yr + yg * yg + yb * yb) / 20.0;

   uint ro = U(etc_planar_q(ar, 63)), go = U(etc_planar_q(ag, 127)),
        bo = U(etc_planar_q(ab, 63));
   uint rh = U(etc_planar_q(ar + 4.0 * bxr, 63)),
        gh = U(etc_planar_q(ag + 4.0 * bxg, 127)),
        bh = U(etc_planar_q(ab + 4.0 * bxb, 63));
   uint rv = U(etc_planar_q(ar + 4.0 * byr, 63)),
        gv = U(etc_planar_q(ag + 4.0 * byg, 127)),
        bv = U(etc_planar_q(ab + 4.0 * byb, 63));

   uint b0w = (ro << 1) | (go >> 6);
   uint b1w = ((go & 63u) << 1) | (bo >> 5);
   uint b2w = (((bo >> 3) & 3u) << 3) | ((bo >> 1) & 3u);
   uint b3w = ((bo & 1u) << 7) | ((rh >> 1) << 2) | 2u | (rh & 1u);
   uint b4w = (gh << 1) | (bh >> 5);
   uint b5w = ((bh & 31u) << 3) | (rv >> 3);
   uint b6w = ((rv & 7u) << 5) | (gv >> 2);
   uint b7w = ((gv & 3u) << 6) | bv;

   b0w = etc_no_overflow(b0w);
   b1w = etc_no_overflow(b1w);
   b2w = etc_force_overflow(b2w);

   g_w0 = b0w | (b1w << 8) | (b2w << 16) | (b3w << 24);
   g_w1 = b4w | (b5w << 8) | (b6w << 16) | (b7w << 24);
   return I(max(res, 0.0) + PLANAR_Q_ERR);
}

/* ETC2 RGB8 / RGB8A1 block for the BC1 palette. Result in g_w0/g_w1,
 * returns its error (an estimate when g_exact is false). */
int
etc2_encode_rgb(bool punch_fmt, uint opts)
{
   uint tm = (punch_fmt && g_c3t) ? pal_mask(3) : 0u;
   bool transparent = tm != 0u;

   /* Colour sums and texel counts of the four half blocks. */
   uint ml = HM_L & ~tm, mr = HM_R & ~tm, mt = HM_T & ~tm, mb = HM_B & ~tm;
   float lr = F(sum_r(ml)), lg = F(sum_g(ml)), lb = F(sum_b(ml));
   float rr = F(sum_r(mr)), rg = F(sum_g(mr)), rb = F(sum_b(mr));
   float tr = F(sum_r(mt)), tg = F(sum_g(mt)), tb = F(sum_b(mt));
   float br = F(sum_r(mb)), bg = F(sum_g(mb)), bb = F(sum_b(mb));
   float nl = F(max(bitCount(ml), 1)), nr = F(max(bitCount(mr), 1));
   float nt = F(max(bitCount(mt), 1)), nb = F(max(bitCount(mb), 1));

   /* The flip whose halves have the larger |sum|^2 / n has the smaller
    * variance inside its halves. */
   float s0 = (lr * lr + lg * lg + lb * lb) / nl + (rr * rr + rg * rg + rb * rb) / nr;
   float s1 = (tr * tr + tg * tg + tb * tb) / nt + (br * br + bg * bg + bb * bb) / nb;
   int flip = s1 > s0 ? 1 : 0;

   int best, e;
   uint w0, w1;
   if ((opts & OPT_FLIPS) != 0u) {
      best = etc_try_flip(0, punch_fmt, transparent, tm, lr, lg, lb, nl, rr, rg,
                          rb, nr, opts);
      w0 = g_w0; w1 = g_w1;
      e = etc_try_flip(1, punch_fmt, transparent, tm, tr, tg, tb, nt, br, bg,
                       bb, nb, opts);
      if (e < best) { best = e; w0 = g_w0; w1 = g_w1; }
   } else {
      bool f = flip != 0;
      best = etc_try_flip(flip, punch_fmt, transparent, tm, f ? tr : lr,
                          f ? tg : lg, f ? tb : lb, f ? nt : nl, f ? br : rr,
                          f ? bg : rg, f ? bb : rb, f ? nb : nr, opts);
      w0 = g_w0; w1 = g_w1;
   }
   g_exact = true;

   /* H and planar have no transparent texels. */
   int n0 = pal_n(0, HM_ALL), n1 = pal_n(1, HM_ALL);
   int n2 = pal_n(2, HM_ALL), n3 = pal_n(3, HM_ALL);
   if (!transparent && (opts & OPT_HMODE) != 0u &&
       ((opts & OPT_H_ALL) != 0u || best > H_SKIP_ERR)) {
      e = etc_try_h(n0, n1, n2, n3);
      if (e < best) { best = e; w0 = g_w0; w1 = g_w1; }
   }
   if (!transparent && (opts & OPT_PLANAR) != 0u) {
      e = etc_try_planar(n0, n1, n2, n3);
      if (e < best) { best = e; w0 = g_w0; w1 = g_w1; g_exact = false; }
   }
   g_w0 = w0;
   g_w1 = w1;
   return best;
}

/* ============================ EAC ============================ */

/* RGTC palette in the EAC domain of the block, BC indices per texel (3
 * bits, texels 0-7 in g_bi0, 8-15 in g_bi1), texels per palette entry (8
 * bits each, entries 0-3 in g_n0, 4-7 in g_n1). g_six: 6-value block whose
 * 0 / 1 entries are unused. */
GLOBAL int g_pv0;
GLOBAL int g_pv1;
GLOBAL int g_pv2;
GLOBAL int g_pv3;
GLOBAL int g_pv4;
GLOBAL int g_pv5;
GLOBAL int g_pv6;
GLOBAL int g_pv7;
GLOBAL uint g_bi0;
GLOBAL uint g_bi1;
GLOBAL uint g_n0;
GLOBAL uint g_n1;
GLOBAL bool g_six;

int
pv(int k)
{
   return k < 4 ? (k < 2 ? (k == 0 ? g_pv0 : g_pv1) : (k == 2 ? g_pv2 : g_pv3))
                : (k < 6 ? (k == 4 ? g_pv4 : g_pv5) : (k == 6 ? g_pv6 : g_pv7));
}

int
pv_n(int k)
{
   return I(((k < 4 ? g_n0 : g_n1) >> U(8 * (k & 3))) & 255u);
}

uint
texel_bi(int p)
{
   return ((p < 8 ? g_bi0 : g_bi1) >> U(3 * (p & 7))) & 7u;
}

/* kind 0: ETC2 alpha (0..255), 1: R11 (0..2047), 2: signed R11
 * (-1023..1023). */
int
eac_off(int kind, int mult, int mod)
{
   int d = kind == 0 ? mod * mult : (mult == 0 ? mod : mod * mult * 8);
   return kind == 1 ? d + 4 : d;
}

/* LUT key of a palette span (in the kind's domain): the span in BC
 * endpoint units, per EAC domain and 6-value flag. */
int
eac_key(int kind, int span, bool six)
{
   int s = kind == 0 ? span
                     : rnd(F(span) * (kind == 1 ? 255.0 / 2047.0 : 127.0 / 1023.0));
   return (kind * 2 + (six ? 1 : 0)) * 256 + clamp(s, 0, 255);
}

/* Candidate c (table | mult << 4) for a key. */
int
eac_lut(int key, int c)
{
   int i = c * 1536 + key;
   return I((EAC_TM_LUT[i >> 2] >> U(8 * (i & 3))) & 255u);
}

#define EAC_MAX_CANDS 3

int
eac_cands(uint opts)
{
   return min(1 + I((opts >> 20) & 3u), EAC_MAX_CANDS);
}

int
eac_scale(int kind)
{
   return kind == 0 ? 1 : 8;
}

int
eac_bmin(int kind)
{
   return kind == 2 ? -127 : 0;
}

int
eac_bmax(int kind)
{
   return kind == 2 ? 127 : 255;
}

/* Centred base codeword for (table, mult) over [lo, hi]. */
int
eac_center(int kind, int t, int mult, int lo, int hi)
{
   float c = 0.5 * F(lo + hi) -
             0.5 * F(eac_off(kind, mult, EAC_MOD[t * 8 + 3]) +
                     eac_off(kind, mult, EAC_MOD[t * 8 + 7]));
   return clamp(rnd(c / F(eac_scale(kind))), eac_bmin(kind), eac_bmax(kind));
}

/* Level spacing of a multiplier, and the level offset of base 0. */
int
eac_step(int kind, int mult)
{
   return kind == 0 ? mult : (mult == 0 ? 1 : 8 * mult);
}

int
eac_c0(int kind)
{
   return kind == 1 ? 4 : 0;
}

int
eac_clampv(int kind, int v)
{
   return kind == 2 ? clamp(v, -1023, 1023) : clamp(v, 0, kind == 0 ? 255 : 2047);
}

/* Nearest modifier of table t for a value d above the base level (step:
 * level spacing, inv = EAC_RES / step): EAC_NEAR entry, idx | (mod + 16)
 * << 3. */
uint
eac_q(int t, int d, float inv)
{
   int x = clamp(rnd(F(d) * inv), -EAC_NX, EAC_NX - 1) + EAC_NX;
   int i = t * 2 * EAC_NX + x;
   return (EAC_NEAR[i >> 2] >> U(8 * (i & 3))) & 255u;
}

int
eac_qmod(uint q)
{
   return I(q >> 3) - 16;
}

/* EAC for the RGTC palette with (table | mult << 4) tm over the used
 * entries [lo, hi]: indices around the centred base, the least-squares
 * base for them, then the indices and the error around that base. Sets
 * g_eac_base / g_eac_map, returns the error over the 16 texels. */
int
eac_try_pal(int kind, int tm, int lo, int hi)
{
   int t = tm & 15, mult = tm >> 4;
   int sc = eac_scale(kind), step = eac_step(kind, mult), c0 = eac_c0(kind);
   float inv = F(EAC_RES) / F(step);

   int bc = eac_center(kind, t, mult, lo, hi) * sc + c0;
   int num = 0;
   UNROLL for (int k = 0; k < 8; k++) {
      uint q = eac_q(t, pv(k) - bc, inv);
      num += pv_n(k) * (pv(k) - c0 - eac_qmod(q) * step);
   }
   int base = clamp(rnd(F(num) / F(16 * sc)), eac_bmin(kind), eac_bmax(kind));

   bc = base * sc + c0;
   uint map = 0u;
   float err = 0.0;
   UNROLL for (int k = 0; k < 8; k++) {
      uint q = eac_q(t, pv(k) - bc, inv);
      err += F(pv_n(k)) * fsq(F(eac_clampv(kind, bc + eac_qmod(q) * step) - pv(k)));
      map |= (q & 7u) << U(4 * k);
   }
   g_eac_base = base;
   g_eac_map = map;
   return I(err);
}

/* Range of the palette entries the block uses. */
int
pal_hi()
{
   int hi = -0x7fff;
   UNROLL for (int k = 0; k < 8; k++)
      hi = pv_n(k) != 0 ? max(hi, pv(k)) : hi;
   return hi;
}

int
pal_lo()
{
   int lo = 0x7fff;
   UNROLL for (int k = 0; k < 8; k++)
      lo = pv_n(k) != 0 ? min(lo, pv(k)) : lo;
   return lo;
}

/* EAC for the RGTC palette: the EAC_CANDS(opts) candidates of the LUT for
 * this span. Sets g_eac_base / g_eac_map and the error in g_sub_t, returns
 * (table | mult << 4). */
int
eac_encode_pal(int kind, uint opts)
{
   int lo = pal_lo(), hi = pal_hi();
   int key = eac_key(kind, hi - lo, g_six);
   int tm = eac_lut(key, 0);
   int err = eac_try_pal(kind, tm, lo, hi);
   int base = g_eac_base;
   uint map = g_eac_map;
   UNROLL for (int c = 1; c < EAC_MAX_CANDS; c++) {
      if (c < eac_cands(opts)) {
         int tm2 = eac_lut(key, c);
         int e2 = eac_try_pal(kind, tm2, lo, hi);
         if (e2 < err) {
            err = e2;
            tm = tm2;
            base = g_eac_base;
            map = g_eac_map;
         }
      }
   }
   g_eac_base = base;
   g_eac_map = map;
   g_sub_t = err;
   return tm;
}

/* BC2 alpha (texels of 4 bits): the same with one entry per texel, whose
 * EAC indices go to g_bi0 / g_bi1 (g_eac_map is the identity). */
int
bc2_v(uint w0, uint w1, int p)
{
   return I(((p < 8 ? w0 : w1) >> U(4 * (p & 7))) & 15u) * 17;
}

int
eac_encode_bc2(uint w0, uint w1)
{
   int lo = 255, hi = 0;
   UNROLL for (int p = 0; p < 16; p++) {
      lo = min(lo, bc2_v(w0, w1, p));
      hi = max(hi, bc2_v(w0, w1, p));
   }

   int tm = eac_lut(eac_key(0, hi - lo, false), 0);
   int t = tm & 15, step = tm >> 4;
   float inv = F(EAC_RES) / F(step);

   int bc = eac_center(0, t, step, lo, hi);
   int num = 0;
   UNROLL for (int p = 0; p < 16; p++) {
      int v = bc2_v(w0, w1, p);
      num += v - eac_qmod(eac_q(t, v - bc, inv)) * step;
   }
   bc = clamp(rnd(F(num) / 16.0), 0, 255);

   uint i0 = 0u, i1 = 0u;
   int err = 0;
   UNROLL for (int p = 0; p < 16; p++) {
      int v = bc2_v(w0, w1, p);
      uint q = eac_q(t, v - bc, inv);
      err += sq(clamp(bc + eac_qmod(q) * step, 0, 255) - v);
      if (p < 8)
         i0 |= (q & 7u) << U(3 * p);
      else
         i1 |= (q & 7u) << U(3 * (p - 8));
   }
   g_bi0 = i0;
   g_bi1 = i1;
   g_eac_base = bc;
   g_eac_map = 0x76543210u; /* entry k -> index k */
   g_sub_t = err;
   return tm;
}

/* EAC block words: base, mult << 4 | table, then the 48 index bits
 * big-endian, pixel (x, y) at bit 45 - 3 (4x + y). Texel indices are
 * g_eac_map applied to the BC indices. */
void
eac_emit(int tm)
{
   uint ihi = 0u, ilo = 0u;
   UNROLL for (int p = 0; p < 16; p++) {
      uint bi = (g_eac_map >> (texel_bi(p) << 2)) & 7u;
      int pos = 45 - 3 * ((p & 3) * 4 + (p >> 2));
      if (pos >= 32) {
         ihi |= bi << U(pos - 32);
      } else {
         ilo |= bi << U(pos);
         if (pos + 3 > 32)
            ihi |= bi >> U(32 - pos);
      }
   }
   uint b0w = U(g_eac_base) & 0xffu;
   uint b1w = U(tm);
   g_w0 = b0w | (b1w << 8) | (((ihi >> 8) & 0xffu) << 16) |
          ((ihi & 0xffu) << 24);
   g_w1 = bswap32(ilo);
}

/* ---- BC decoders (same arithmetic as the exact decode shaders) ---- */

int
unorm8(float f)
{
   return clamp(rnd(f * 255.0), 0, 255);
}

/* BC1 colour block (words c0, c1): every palette entry is the expression
 * the per-texel exact decode evaluates. */
void
bc_decode_color(uint c0w, uint c1w, bool four)
{
   uint e0 = c0w & 0xffffu, e1 = c0w >> 16;
   bool opaque = four || e0 > e1;
   float r0 = F((e0 >> 11) & 31u) / 31.0, g0 = F((e0 >> 5) & 63u) / 63.0,
         b0 = F(e0 & 31u) / 31.0;
   float r1 = F((e1 >> 11) & 31u) / 31.0, g1 = F((e1 >> 5) & 63u) / 63.0,
         b1 = F(e1 & 31u) / 31.0;

   float f2 = opaque ? (1.0 / 3.0) * F(1) : 0.5;
   float f3 = (1.0 / 3.0) * F(2);
   g_r0 = unorm8(r0);
   g_g0 = unorm8(g0);
   g_b0 = unorm8(b0);
   g_r1 = unorm8(r0 + (r1 - r0) * 1.0);
   g_g1 = unorm8(g0 + (g1 - g0) * 1.0);
   g_b1 = unorm8(b0 + (b1 - b0) * 1.0);
   g_r2 = unorm8(r0 + (r1 - r0) * f2);
   g_g2 = unorm8(g0 + (g1 - g0) * f2);
   g_b2 = unorm8(b0 + (b1 - b0) * f2);
   g_r3 = opaque ? unorm8(r0 + (r1 - r0) * f3) : 0;
   g_g3 = opaque ? unorm8(g0 + (g1 - g0) * f3) : 0;
   g_b3 = opaque ? unorm8(b0 + (b1 - b0) * f3) : 0;
   g_fr0 = F(g_r0); g_fg0 = F(g_g0); g_fb0 = F(g_b0);
   g_fr1 = F(g_r1); g_fg1 = F(g_g1); g_fb1 = F(g_b1);
   g_fr2 = F(g_r2); g_fg2 = F(g_g2); g_fb2 = F(g_b2);
   g_fr3 = F(g_r3); g_fg3 = F(g_g3); g_fb3 = F(g_b3);
   g_ci = c1w;
   g_grp = opaque ? 0xau : 0xeu;
   g_c3t = !opaque;
}

/* RGTC/BC3 alpha channel (words a0, a1) as floats in [0, 1] / [-1, 1],
 * converted to the EAC domain of 'kind'. */
int
rgtc_out(float res, int kind)
{
   if (kind == 0)
      return unorm8(res);
   if (kind == 1)
      return clamp(rnd(res * 2047.0), 0, 2047);
   return clamp(rnd(res * 1023.0), -1023, 1023);
}

void
bc_decode_rgtc(uint a0w, uint a1w, bool snorm, int kind)
{
   float ep0, ep1;
   if (snorm) {
      ep0 = max(F(I(a0w << 24) >> 24) / 127.0, -1.0);
      ep1 = max(F(I(a0w << 16) >> 24) / 127.0, -1.0);
   } else {
      ep0 = F(a0w & 0xffu) / 255.0;
      ep1 = F((a0w >> 8) & 0xffu) / 255.0;
   }
   bool range7 = ep0 > ep1;

   g_pv0 = rgtc_out(ep0, kind);
   g_pv1 = rgtc_out(ep1, kind);
   if (range7) {
      g_pv2 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 7.0) * F(1u)), kind);
      g_pv3 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 7.0) * F(2u)), kind);
      g_pv4 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 7.0) * F(3u)), kind);
      g_pv5 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 7.0) * F(4u)), kind);
      g_pv6 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 7.0) * F(5u)), kind);
      g_pv7 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 7.0) * F(6u)), kind);
   } else {
      g_pv2 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 5.0) * F(1u)), kind);
      g_pv3 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 5.0) * F(2u)), kind);
      g_pv4 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 5.0) * F(3u)), kind);
      g_pv5 = rgtc_out(ep0 + (ep1 - ep0) * ((1.0 / 5.0) * F(4u)), kind);
      g_pv6 = rgtc_out(snorm ? -1.0 : 0.0, kind);
      g_pv7 = rgtc_out(1.0, kind);
   }

   g_bi0 = (a0w >> 16) | ((a1w & 0xffu) << 16);
   g_bi1 = a1w >> 8;
   uint n0 = 0u, n1 = 0u;
   UNROLL for (int p = 0; p < 16; p++) {
      uint b = texel_bi(p);
      uint inc = 1u << (8u * (b & 3u));
      n0 += b < 4u ? inc : 0u;
      n1 += b < 4u ? 0u : inc;
   }
   g_n0 = n0;
   g_n1 = n1;
   g_six = !range7 && (n1 & 0xffff0000u) == 0u;
}

/* One EAC channel from RGTC words: g_w0 / g_w1. */
void
eac_rgtc(uint a0w, uint a1w, bool snorm, int kind, uint opts)
{
   bc_decode_rgtc(a0w, a1w, snorm, kind);
   eac_emit(eac_encode_pal(kind, opts));
}

/* csf-v11/206: EAC from the endpoint pair table (panvk_bc_eac_lut.h): one
 * load gives the EAC header and the palette entry -> EAC index map, then
 * the 16 BC indices are remapped into the EAC index order. No palette
 * decode, no search: a few cycles and few registers per block. */
#ifdef PANVK_BC_C_TEST
GLOBAL const uint *xc_eac_lut;
#endif

void
eac_fast(uint a0w, uint a1w)
{
   uint key = a0w & 0xffffu;
#ifdef PANVK_BC_C_TEST
   uint hdr = xc_eac_lut[2u * key];
   uint map = xc_eac_lut[2u * key + 1u];
#else
   uvec2 e = In2(registers.lut).data[key];
   uint hdr = e.x;
   uint map = e.y;
#endif
   uint bi0 = (a0w >> 16) | ((a1w & 0xffu) << 16);
   uint bi1 = a1w >> 8;
   uint ihi = 0u, ilo = 0u;
   UNROLL for (int p = 0; p < 16; p++) {
      uint b = ((p < 8 ? bi0 : bi1) >> U(3 * (p & 7))) & 7u;
      uint v = (map >> (3u * b)) & 7u;
      int pos = 45 - 3 * ((p & 3) * 4 + (p >> 2));
      if (pos >= 32) {
         ihi |= v << U(pos - 32);
      } else {
         ilo |= v << U(pos);
         if (pos + 3 > 32)
            ihi |= v >> U(32 - pos);
      }
   }
   g_w0 = (hdr & 0xffffu) | (((ihi >> 8) & 0xffu) << 16) | ((ihi & 0xffu) << 24);
   g_w1 = bswap32(ilo);
}

/* ============== BC1 palette fit (csf-v11/210, OPT_BC1_PAL) ============== */

/* BC1 RGB / RGBA only: BC2 and BC3 colour keep etc2_encode_rgb(). The block
 * structure is the same (flip by half-block variance, differential or
 * individual base per half, H mode when the ETC1 error is above
 * H_SKIP_ERR), but every choice is made on the luma axis of the at most 4
 * palette colours. The ETC1 modifiers and the H distance move the three
 * channels together, so for a colour at luma offset s (x3) from a base,
 * |p - (base + m)|^2 = |p - base|^2 - 2 m s + 3 m^2 and the best modifier
 * is the one nearest s / 3 (the palette fit of GunaCharanTeja's
 * csf-v11/214, MIT). Only the chosen indices get the exact (clamped)
 * error, instead of the nearest of the 4 clamped levels for every colour
 * (48 distances per half).
 *
 * Register pressure is what made the encoder above spill (58 registers,
 * 17 spills on Valhall). The palette is kept packed (8:8:8, 4 registers
 * instead of 24), the errors run in fp32 on the FMA unit (exact, as in
 * csf-v11/203), the differential / individual header and bases are packed
 * before the two half fits, and the index planes are a mux on the BC
 * index bits instead of per-colour masks. The H mode takes its per-colour
 * texel counts from the index bit planes rather than the masks the ETC1
 * fit uses: CSEd with it, those would stay live across the whole ETC1 fit.
 * Its group flag rides in bit 24 of g_p3. */
GLOBAL uint g_p0;
GLOBAL uint g_p1;
GLOBAL uint g_p2;
GLOBAL uint g_p3;
void
bc1p_pack()
{
   g_p0 = U(g_r0) | (U(g_g0) << 8) | (U(g_b0) << 16);
   g_p1 = U(g_r1) | (U(g_g1) << 8) | (U(g_b1) << 16);
   g_p2 = U(g_r2) | (U(g_g2) << 8) | (U(g_b2) << 16);
   /* Bit 24: g_grp is 0xa (4-colour block), else 0xe. It rides along
    * with the palette into the H mode instead of taking a register. */
   g_p3 = U(g_r3) | (U(g_g3) << 8) | (U(g_b3) << 16) |
          (g_grp == 0xau ? 0x1000000u : 0u);
}

uint
pp(int k)
{
   return k == 0 ? g_p0 : (k == 1 ? g_p1 : (k == 2 ? g_p2 : g_p3));
}

float
pch(uint c, int i)
{
   return F((c >> U(8 * i)) & 255u);
}

float
plum(uint c)
{
   return pch(c, 0) + pch(c, 1) + pch(c, 2);
}

/* Index bit plane 'bit' (1: LSB, 2: MSB) of all texels for the ETC index
 * map (colour k at bits 2k), as a mux on the BC index bits: no per-colour
 * masks stay live until the block is packed. */
uint
bc1p_plane(uint map, uint bit)
{
   uint lo = g_ci & HM_ALL, hi = (g_ci >> 1) & HM_ALL;
   uint m0 = (map & bit) != 0u ? HM_ALL : 0u;
   uint m1 = (map & (bit << 2)) != 0u ? HM_ALL : 0u;
   uint m2 = (map & (bit << 4)) != 0u ? HM_ALL : 0u;
   uint m3 = (map & (bit << 6)) != 0u ? HM_ALL : 0u;
   uint t0 = m0 ^ (lo & (m1 ^ m0)), t1 = m2 ^ (lo & (m3 ^ m2));
   return t0 ^ (hi & (t1 ^ t0));
}

/* Exact error of colour c against clamp(base + m) per channel. */
float
pal_err_m(uint c, float br, float bg, float bb, float m)
{
   return fsq(pch(c, 0) - clamp(br + m, 0.0, 255.0)) +
          fsq(pch(c, 1) - clamp(bg + m, 0.0, 255.0)) +
          fsq(pch(c, 2) - clamp(bb + m, 0.0, 255.0));
}

/* ETC1 index of luma offset s (x3) for modifiers a3, b3 (x3): the nearest
 * of +-a, +-b (ties keep the lower index). punch: RGB8A1 transparent
 * block, a is 0 and index 2 is transparent, so a small offset is index 0. */
uint
bc1p_idx(float s, float a3, float b3, bool punch)
{
   float u = abs(s);
   bool big = fsq(u - b3) < fsq(u - a3);
   if (!big && punch)
      return 0u;
   return (big ? 1u : 0u) | (s < 0.0 ? 2u : 0u);
}

/* Weighted 1D error of modifiers a3, b3 (x3) over the colours of m around
 * luma bl. */
float
bc1p_tab_err(uint m, float bl, float a3, float b3)
{
   float e = 0.0;
   UNROLL for (int k = 0; k < 4; k++) {
      float u = abs(plum(pp(k)) - bl);
      e += F(pal_n(k, m)) * min(fsq(u - a3), fsq(u - b3));
   }
   return e;
}

/* Table, indices (g_sub_t, g_sub_map) and exact error of the texels of hm
 * (minus tm) around base (8:8:8). */
float
bc1p_half(uint hm, uint tm, uint base, bool punch)
{
   uint m = hm & ~tm;
   float br = pch(base, 0), bg = pch(base, 1), bb = pch(base, 2);
   float bl = br + bg + bb;

   float umax = 0.0;
   UNROLL for (int k = 0; k < 4; k++)
      umax = max(umax, pal_n(k, m) != 0 ? abs(plum(pp(k)) - bl) : 0.0);
   int t0 = 0;
   UNROLL for (int t = 0; t < 7; t++)
      t0 += umax > F(ETC1_UTH[t]) ? 1 : 0;
   t0 = clamp(t0, 1, 6);
   float e0 = bc1p_tab_err(m, bl, punch ? 0.0 : F(3 * ETC1_A[t0 - 1]), F(3 * ETC1_B[t0 - 1]));
   float e1 = bc1p_tab_err(m, bl, punch ? 0.0 : F(3 * ETC1_A[t0]), F(3 * ETC1_B[t0]));
   float e2 = bc1p_tab_err(m, bl, punch ? 0.0 : F(3 * ETC1_A[t0 + 1]), F(3 * ETC1_B[t0 + 1]));
   int bt = e0 <= e1 ? (e0 <= e2 ? t0 - 1 : t0 + 1) : (e1 <= e2 ? t0 : t0 + 1);

   float a = punch ? 0.0 : F(ETC1_A[bt]), b = F(ETC1_B[bt]);
   float err = 0.0;
   uint map = 0u;
   UNROLL for (int k = 0; k < 4; k++) {
      uint c = pp(k);
      float s = plum(c) - bl;
      uint i = bc1p_idx(s, 3.0 * a, 3.0 * b, punch);
      /* RGB8A1: colour 3 of a transparent block is index 2 (not in m). */
      i = (punch && k == 3) ? 2u : i;
      float v = (i & 1u) != 0u ? b : a;
      err += F(pal_n(k, m)) * pal_err_m(c, br, bg, bb, (i & 2u) != 0u ? -v : v);
      map |= i << U(2 * k);
   }
   g_sub_t = bt;
   g_sub_map = map;
   return err;
}

/* Colour sum (channel c) of the texels of mask m. */
float
bc1p_sum(uint m, int c)
{
   float s = 0.0;
   UNROLL for (int k = 0; k < 4; k++)
      s += F(pal_n(k, m)) * pch(pp(k), c);
   return s;
}

/* |sum|^2 / n of the texels of m: the flip whose halves have the larger
 * total has the smaller variance inside its halves. */
float
bc1p_flip_score(uint m)
{
   float r = 0.0, g = 0.0, b = 0.0;
   UNROLL for (int k = 0; k < 4; k++) {
      float n = F(pal_n(k, m));
      uint c = pp(k);
      r += n * pch(c, 0);
      g += n * pch(c, 1);
      b += n * pch(c, 2);
   }
   return (r * r + g * g + b * b) / F(max(bitCount(m), 1));
}

/* etc_try_flip() on the packed palette. */
float
bc1p_try_flip(int flip, bool punch_fmt, bool transparent, uint tm)
{
   uint h0 = flip != 0 ? HM_T : HM_L;
   uint h1 = flip != 0 ? HM_B : HM_R;
   uint m0 = h0 & ~tm, m1 = h1 & ~tm;
   float n0 = F(max(bitCount(m0), 1)), n1 = F(max(bitCount(m1), 1));
   float sr0 = bc1p_sum(m0, 0), sg0 = bc1p_sum(m0, 1), sb0 = bc1p_sum(m0, 2);
   float sr1 = bc1p_sum(m1, 0), sg1 = bc1p_sum(m1, 1), sb1 = bc1p_sum(m1, 2);

   int r0 = clamp(rnd(sr0 * 31.0 / (255.0 * n0)), 0, 31);
   int g0 = clamp(rnd(sg0 * 31.0 / (255.0 * n0)), 0, 31);
   int b0 = clamp(rnd(sb0 * 31.0 / (255.0 * n0)), 0, 31);
   int r1 = clamp(rnd(sr1 * 31.0 / (255.0 * n1)), 0, 31);
   int g1 = clamp(rnd(sg1 * 31.0 / (255.0 * n1)), 0, 31);
   int b1 = clamp(rnd(sb1 * 31.0 / (255.0 * n1)), 0, 31);
   int dr = r1 - r0, dg = g1 - g0, db = b1 - b0;
   bool fits = dr >= -4 && dr <= 3 && dg >= -4 && dg <= 3 && db >= -4 &&
               db <= 3;
   bool diff = fits || punch_fmt;

   /* Packed early (8:8:8 bases, header word without the tables): fewer
    * values live across the two half fits. */
   uint hdr, e0p, e1p;
   if (diff) {
      dr = clamp(dr, -4, 3);
      dg = clamp(dg, -4, 3);
      db = clamp(db, -4, 3);
      r1 = r0 + dr; g1 = g0 + dg; b1 = b0 + db;
      e0p = U((r0 << 3) | (r0 >> 2)) | (U((g0 << 3) | (g0 >> 2)) << 8) |
            (U((b0 << 3) | (b0 >> 2)) << 16);
      e1p = U((r1 << 3) | (r1 >> 2)) | (U((g1 << 3) | (g1 >> 2)) << 8) |
            (U((b1 << 3) | (b1 >> 2)) << 16);
      hdr = U((r0 << 3) | (dr & 7)) | (U((g0 << 3) | (dg & 7)) << 8) |
            (U((b0 << 3) | (db & 7)) << 16);
   } else {
      uint ir0 = U(clamp(rnd(sr0 * 15.0 / (255.0 * n0)), 0, 15));
      uint ig0 = U(clamp(rnd(sg0 * 15.0 / (255.0 * n0)), 0, 15));
      uint ib0 = U(clamp(rnd(sb0 * 15.0 / (255.0 * n0)), 0, 15));
      uint ir1 = U(clamp(rnd(sr1 * 15.0 / (255.0 * n1)), 0, 15));
      uint ig1 = U(clamp(rnd(sg1 * 15.0 / (255.0 * n1)), 0, 15));
      uint ib1 = U(clamp(rnd(sb1 * 15.0 / (255.0 * n1)), 0, 15));
      e0p = (ir0 * 17u) | ((ig0 * 17u) << 8) | ((ib0 * 17u) << 16);
      e1p = (ir1 * 17u) | ((ig1 * 17u) << 8) | ((ib1 * 17u) << 16);
      hdr = ((ir0 << 4) | ir1) | (((ig0 << 4) | ig1) << 8) |
            (((ib0 << 4) | ib1) << 16);
   }
   /* Bit 1 of byte 3 is the diff bit, or the opaque bit for RGB8A1. */
   uint dbit = punch_fmt ? (transparent ? 0u : 2u) : (diff ? 2u : 0u);
   hdr |= (dbit | U(flip)) << 24;

   float err = bc1p_half(h0, tm, e0p, transparent);
   uint t0 = U(g_sub_t);
   uint map0 = g_sub_map;
   err += bc1p_half(h1, tm, e1p, transparent);
   uint t1 = U(g_sub_t);
   uint map1 = g_sub_map;

   g_w0 = hdr | (((t0 << 5) | (t1 << 2)) << 24);
   g_w1 = etc_pack_planes((bc1p_plane(map0, 1u) & h0) | (bc1p_plane(map1, 1u) & ~h0),
                          (bc1p_plane(map0, 2u) & h0) | (bc1p_plane(map1, 2u) & ~h0));
   return err;
}

/* 444 mean colour of the palette colours weighted by w0..w3 (n texels),
 * r << 8 | g << 4 | b. */
uint
bc1p_q444(int w0, int w1, int w2, int w3, int n)
{
   float f = 15.0 / (255.0 * F(n));
   float fw0 = F(w0), fw1 = F(w1), fw2 = F(w2), fw3 = F(w3);
   uint q = 0u;
   UNROLL for (int c = 0; c < 3; c++) {
      float sum = fw0 * pch(g_p0, c) + fw1 * pch(g_p1, c) +
                  fw2 * pch(g_p2, c) + fw3 * pch(g_p3, c);
      q = (q << 4) | U(clamp(rnd(sum * f), 0, 15));
   }
   return q;
}

/* Channel i (0 = r) of a 444 colour, expanded to 8 bits. */
float
q444_ch(uint q, int i)
{
   return F(((q >> U(8 - 4 * i)) & 15u) * 17u);
}

float
q444_lum(uint q)
{
   return q444_ch(q, 0) + q444_ch(q, 1) + q444_ch(q, 2);
}

/* etc_try_h() on the packed palette, indices on the luma axis: a colour
 * keeps its BC endpoint group and takes the +d or -d level of it. */
float
bc1p_try_h()
{
   /* Texels per colour from the BC index bit planes (no per-colour masks:
    * those would be CSEd with the ETC1 fit and stay live across it). */
   uint lo = g_ci & HM_ALL, hi = (g_ci >> 1) & HM_ALL;
   int n3 = bitCount(lo & hi), n1 = bitCount(lo) - n3, n2 = bitCount(hi) - n3;
   int n0 = 16 - n1 - n2 - n3;
   uint grp = (g_p3 & 0x1000000u) != 0u ? 0xau : 0xeu;
   bool g0 = (grp & 1u) != 0u, g1 = (grp & 2u) != 0u;
   bool g2 = (grp & 4u) != 0u, g3 = (grp & 8u) != 0u;
   int na = (g0 ? 0 : n0) + (g1 ? 0 : n1) + (g2 ? 0 : n2) + (g3 ? 0 : n3);
   int nb = 16 - na;
   if (na == 0 || nb == 0)
      return 1e30;
   uint qa = bc1p_q444(g0 ? 0 : n0, g1 ? 0 : n1, g2 ? 0 : n2, g3 ? 0 : n3, na);
   uint qb = bc1p_q444(g0 ? n0 : 0, g1 ? n1 : 0, g2 ? n2 : 0, g3 ? n3 : 0, nb);
   if (qa == qb)
      return 1e30;

   float la = q444_lum(qa), lc = q444_lum(qb);
   float um = 0.0;
   UNROLL for (int k = 0; k < 4; k++) {
      bool gk = ((grp >> U(k)) & 1u) != 0u;
      um += F(k == 0 ? n0 : (k == 1 ? n1 : (k == 2 ? n2 : n3))) * abs(plum(pp(k)) - (gk ? lc : la));
   }
   um = floor(um * (1.0 / 16.0));
   int i0 = 0;
   UNROLL for (int i = 0; i < 7; i++)
      i0 += um > F(ETC_H_UTH[i]) ? 1 : 0;
   i0 = clamp(i0, 1, 6);
   float best = 1e30;
   int di = 0;
   UNROLL for (int j = -1; j <= 1; j++) {
      float d3 = F(3 * ETC_H_DIST[i0 + j]);
      float e = 0.0;
      UNROLL for (int k = 0; k < 4; k++) {
         bool gk = ((grp >> U(k)) & 1u) != 0u;
         e += F(k == 0 ? n0 : (k == 1 ? n1 : (k == 2 ? n2 : n3))) * fsq(abs(plum(pp(k)) - (gk ? lc : la)) - d3);
      }
      if (e < best) { best = e; di = i0 + j; }
   }

   /* The distance LSB is (colour 1 >= colour 2): swap to match it. Group
    * A (endpoint 0 side) is the first H colour unless swapped. */
   bool swap = (di & 1) != ((qa >= qb) ? 1 : 0);
   float d = F(ETC_H_DIST[di]);
   float err = 0.0;
   uint map = 0u;
   UNROLL for (int k = 0; k < 4; k++) {
      bool gk = ((grp >> U(k)) & 1u) != 0u;
      uint c = pp(k), q = gk ? qb : qa;
      bool neg = plum(c) < q444_lum(q);
      err += F(k == 0 ? n0 : (k == 1 ? n1 : (k == 2 ? n2 : n3))) *
             pal_err_m(c, q444_ch(q, 0), q444_ch(q, 1), q444_ch(q, 2), neg ? -d : d);
      map |= (((gk != swap) ? 2u : 0u) | (neg ? 1u : 0u)) << U(2 * k);
   }

   uint q1 = swap ? qb : qa, q2 = swap ? qa : qb;
   uint r1q = q1 >> 8, g1q = (q1 >> 4) & 15u, b1q = q1 & 15u;
   uint r2q = q2 >> 8, g2q = (q2 >> 4) & 15u, b2q = q2 & 15u;
   uint dib = U(di);

   uint b0w = (r1q << 3) | (g1q >> 1);
   uint b1w = ((g1q & 1u) << 4) | (b1q & 8u) | ((b1q >> 1) & 3u);
   uint b2w = ((b1q & 1u) << 7) | (r2q << 3) | (g2q >> 1);
   uint b3w = ((g2q & 1u) << 7) | (b2q << 3) | (((dib >> 2) & 1u) << 2) | 2u |
              ((dib >> 1) & 1u);

   b0w = etc_no_overflow(b0w);
   b1w = etc_force_overflow(b1w);

   g_w0 = b0w | (b1w << 8) | (b2w << 16) | (b3w << 24);
   g_w1 = etc_pack_planes(bc1p_plane(map, 1u), bc1p_plane(map, 2u));
   return err;
}

/* ETC2 RGB8 / RGB8A1 block of a BC1 palette (bc_decode_color() done):
 * result in g_w0/g_w1. OPT_FLIPS, OPT_TAB8 and OPT_PLANAR do not apply. */
void
etc2_encode_bc1_pal(bool punch_fmt, uint opts)
{
   bc1p_pack();
   uint tm = (punch_fmt && g_c3t) ? pal_mask(3) : 0u;
   bool transparent = tm != 0u;

   float s0 = bc1p_flip_score(HM_L & ~tm) + bc1p_flip_score(HM_R & ~tm);
   float s1 = bc1p_flip_score(HM_T & ~tm) + bc1p_flip_score(HM_B & ~tm);
   float best = bc1p_try_flip(s1 > s0 ? 1 : 0, punch_fmt, transparent, tm);
   if (!transparent && (opts & OPT_HMODE) != 0u &&
       ((opts & OPT_H_ALL) != 0u || best > F(H_SKIP_ERR))) {
      uint w0 = g_w0, w1 = g_w1;
      if (bc1p_try_h() >= best) { g_w0 = w0; g_w1 = w1; }
   }
}

/* Transcode one BC block (w0..w3) for 'mode'. The ETC2/EAC words go to
 * g_out0..3. */
void
transcode_block(uint mode, uint w0, uint w1, uint w2, uint w3, uint opts)
{
   if (mode == U(XC_BC1_RGB) || mode == U(XC_BC1_RGBA)) {
      bc_decode_color(w0, w1, false);
      if ((opts & OPT_BC1_PAL) != 0u)
         etc2_encode_bc1_pal(mode == U(XC_BC1_RGBA), opts);
      else
         etc2_encode_rgb(mode == U(XC_BC1_RGBA), opts);
      g_out0 = g_w0;
      g_out1 = g_w1;
      g_out2 = 0u;
      g_out3 = 0u;
   } else if (mode == U(XC_BC2) || mode == U(XC_BC3)) {
      if (mode == U(XC_BC2)) {
         eac_emit(eac_encode_bc2(w0, w1));
      } else if ((opts & OPT_EAC_SEARCH) != 0u) {
         eac_rgtc(w0, w1, false, 0, opts);
      } else {
         eac_fast(w0, w1);
      }
      g_out0 = g_w0;
      g_out1 = g_w1;
      bc_decode_color(w2, w3, true);
      etc2_encode_rgb(false, opts);
      g_out2 = g_w0;
      g_out3 = g_w1;
   } else {
      bool snorm = mode == U(XC_BC4_S) || mode == U(XC_BC5_S);
      int kind = snorm ? 2 : 1;
      if ((opts & OPT_EAC_SEARCH) != 0u)
         eac_rgtc(w0, w1, snorm, kind, opts);
      else
         eac_fast(w0, w1);
      g_out0 = g_w0;
      g_out1 = g_w1;
      g_out2 = 0u;
      g_out3 = 0u;
      if (mode >= U(XC_BC5_U)) {
         if ((opts & OPT_EAC_SEARCH) != 0u)
            eac_rgtc(w2, w3, snorm, kind, opts);
         else
            eac_fast(w2, w3);
         g_out2 = g_w0;
         g_out3 = g_w1;
      }
   }
}

#ifndef PANVK_BC_C_TEST
/* a + m0 * m1 for a 64-bit address a (arrays above 4 GiB). */
uvec2
addr_mad(uvec2 a, uint m0, uint m1)
{
   uint hi, lo, c;
   umulExtended(m0, m1, hi, lo);
   a.x = uaddCarry(a.x, lo, c);
   a.y += hi + c;
   return a;
}

void
main()
{
   uint x = gl_GlobalInvocationID.x;
   uint y = gl_GlobalInvocationID.y;
   uint z = gl_GlobalInvocationID.z;

   if (x >= registers.bw || y >= registers.bh)
      return;

   bool wide = !(XC_MODE == U(XC_BC1_RGB) || XC_MODE == U(XC_BC1_RGBA) ||
                 XC_MODE == U(XC_BC4_U) || XC_MODE == U(XC_BC4_S));

   uvec2 sa = addr_mad(addr_mad(registers.src, z, registers.src_slice_B), y,
                       registers.src_row_B);
   uvec4 w;
   if (wide)
      w = In4(sa).data[x];
   else
      w = uvec4(In2(sa).data[x], 0u, 0u);

   /* Upload into a raw-store image (csf-v11/203): keep the BC blocks here
    * instead of a separate copy pass over the source. */
   if ((registers.raw.x | registers.raw.y) != 0u) {
      uvec2 ra = addr_mad(addr_mad(registers.raw, z, registers.raw_slice_B),
                          y, registers.raw_row_B);
      if (wide)
         Out4(ra).data[x] = w;
      else
         Out2(ra).data[x] = w.xy;
   }

   /* U-interleaved: 4x4-block tiles stored linearly per tile row, blocks in
    * a tile at | y1 | x1^y1 | y0 | x0^y0 |. The address is final before
    * the transcode, so only it (not x, y, z) stays live across. */
   uint bx = registers.bx0 + x, by = registers.by0 + y;
   uint ix = bx & 3u, iy = by & 3u;
   uint in_tile = ((iy >> 1) << 3) | (((ix ^ iy) >> 1) << 2) |
                  ((iy & 1u) << 1) | ((ix ^ iy) & 1u);
   uvec2 da = addr_mad(addr_mad(registers.dst, z, registers.dst_slice_B),
                       by >> 2, registers.dst_row_B);
   da = addr_mad(da, (bx >> 2) * 16u + in_tile, wide ? 16u : 8u);

   transcode_block(XC_MODE, w.x, w.y, w.z, w.w, XC_OPTS);

   if (wide)
      Out4(da).data[0] = uvec4(g_out0, g_out1, g_out2, g_out3);
   else
      Out2(da).data[0] = uvec2(g_out0, g_out1);
}
#endif
