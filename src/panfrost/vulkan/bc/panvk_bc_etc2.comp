#version 450
/*
 * Copyright 2026 PanVK-kbase contributors
 * SPDX-License-Identifier: MIT
 *
 * BC1-BC5 -> ETC2/EAC transcoder for the BC lowmem path (csf-v11/197,
 * palette-domain encoder since csf-v11/200).
 *
 * One invocation per 4x4 block. The BC block is decoded exactly (same
 * arithmetic as panvk_bc_s3tc.comp / panvk_bc_rgtc.comp) and re-encoded:
 *
 *   BC1 RGB         -> ETC2 RGB8     (diff/individual, H and planar modes)
 *   BC1 RGBA        -> ETC2 RGB8A1   (punch-through for blocks with alpha)
 *   BC2, BC3        -> ETC2 RGBA8    (EAC alpha + ETC2 colour)
 *   BC4 UNORM/SNORM -> EAC R11 (signed)
 *   BC5 UNORM/SNORM -> EAC RG11 (signed)
 *
 * A BC block holds at most 4 colours (BC1) or 8 values (BC3 alpha, BC4,
 * BC5), so the encoder works on the palette, not on the 16 texels:
 *
 *  - EAC: the (table, multiplier) pair comes from EAC_TM_LUT, indexed by
 *    the span of the palette entries the block uses (built offline by
 *    tests/bc-host/gen_eac_lut over every BC4 endpoint pair, for exactly
 *    this encoder). The base codeword is centred, each palette entry is
 *    mapped to its nearest EAC level once (8 entries x 8 levels) and the
 *    base is refined by least squares over the entries weighted by their
 *    texel counts. Texel indices are then a 3-bit remap of the BC indices.
 *  - ETC2 RGB: palette colour counts per half block come from popcounts of
 *    the BC index word. The flip is chosen by the half-block variance, the
 *    ETC1 table by a 1D search on the luma offsets of the (at most 4)
 *    colours, then the indices exactly (with clamping). The H mode is
 *    seeded by the two BC1 endpoint groups, its distance by the same 1D
 *    search; the planar mode is a least-squares plane from palette moments
 *    with an error estimate. Texel indices are bit planes built from the
 *    palette masks.
 *
 * The block mode and the options are specialization constants (one
 * pipeline per BC format class), the workgroup size too. Blocks are loaded
 * and stored as one uvec2 / uvec4, and no per-block array is indexed at run
 * time (all loops have fixed trip counts).
 *
 * csf-v11/203: the ETC1 / H error sums run in fp32 (exact: at most
 * 16 * 3 * 255^2 < 2^24) on the otherwise idle FMA unit instead of 32-bit
 * IMUL / integer ALU (same bitstream, about 25% fewer Valhall cycles for
 * BC1-BC3), and an upload into a raw-store image writes the raw blocks
 * here (registers.raw) instead of in a separate copy pass.
 *
 * csf-v11/210: BC1 RGB / RGBA through a cheaper palette fit on the luma
 * axis (OPT_BC1_PAL, default), without the register spills of the
 * encoder BC2 / BC3 colour keeps; see etc2_encode_bc1_pal().
 *
 * The encoder is written in the GLSL subset that is also valid C (I()/U()/F()
 * casts, CARR tables, no out parameters) so it can be unit tested on the
 * host by including this file with PANVK_BC_C_TEST defined (skip line 1),
 * see tests/bc-host in panvk-kbase-android.
 */

#ifndef PANVK_BC_C_TEST
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1,
       local_size_x_id = 0, local_size_y_id = 1) in;

layout(constant_id = 2) const uint XC_MODE = 0u;      /* XC_* */
layout(constant_id = 3) const uint XC_OPTS = 0x30000u; /* PANVK_BC_LM_OPTS */

layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer In2 {
    uvec2 data[];
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer In4 {
    uvec4 data[];
};

layout(buffer_reference, std430, buffer_reference_align = 8) writeonly buffer Out2 {
    uvec2 data[];
};

layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer Out4 {
    uvec4 data[];
};

layout(push_constant) uniform Registers
{
    uvec2 src;        /* block (0, 0) of layer 0 of the region */
    uvec2 dst;        /* shadow level base, layer 0 */
    uint src_row_B;
    uint src_slice_B;
    uint dst_row_B;   /* bytes per row of 4x4-block tiles */
    uint dst_slice_B; /* array stride */
    uint bx0;         /* region origin in blocks (for the tiled address) */
    uint by0;
    uint bw;          /* region size in blocks */
    uint bh;
    uvec2 raw;        /* raw store copy of the source blocks (0: none) */
    uint raw_row_B;
    uint raw_slice_B;
    uvec2 lut;        /* csf-v11/206: EAC table of the mode's kind */
} registers;

#define I(x) int(x)
#define U(x) uint(x)
#define F(x) float(x)
#define GLOBAL
#define CARR(type, name, n) const type name[n] = type[n](
#define CEND );
#define UNROLL [[unroll]]
#endif

/* Must match panvk_vX_cmd_meta.c. */
#define XC_BC1_RGB  0
#define XC_BC1_RGBA 1
#define XC_BC2      2
#define XC_BC3      3
#define XC_BC4_U    4
#define XC_BC4_S    5
#define XC_BC5_U    6
#define XC_BC5_S    7

/* PANVK_BC_LM_OPTS bits (default 0x30000). */
#define OPT_PLANAR 0x10000u /* try the ETC2 planar mode */
#define OPT_HMODE  0x20000u /* try the ETC2 H mode */
#define OPT_FLIPS  0x40000u /* encode both flips instead of picking one */
#define OPT_TAB8   0x80000u /* ETC1: 1D search over all 8 tables, not 3 */
/* csf-v11/206: EAC by the search of csf-v11/200-203 (palette span LUT,
 * centred and least-squares base, PANVK_BC_LM_OPTS bits 20-21 candidates)
 * instead of the endpoint pair table (eac_fast()). */
#define OPT_EAC_SEARCH 0x400000u
/* csf-v11/206: try the H mode on every block, not only on blocks whose
 * ETC1 error is above H_SKIP_ERR. */
#define OPT_H_ALL 0x800000u
/* csf-v11/210: BC1 RGB / RGBA through the palette fit on the luma axis
 * (etc2_encode_bc1_pal()); BC2 / BC3 colour is not affected. */
#define OPT_BC1_PAL 0x1000000u
#ifndef H_SKIP_ERR
#define H_SKIP_ERR 1024
#endif
