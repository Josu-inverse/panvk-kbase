DecodedInterpolation decode_bc6_mode30(uvec4 payload, int linear_pixel, int part, int anchor_pixel)
{
    ivec3 ep0, ep1;

    if (part != 0)
    {
        int r2 = extract_bits(payload, 65, 6);
        int g2 = extract_bits(payload, 41, 4) | (extract_bits(payload, 24, 1) << 4) | (extract_bits(payload, 21, 1) << 5);
        int b2 = extract_bits(payload, 61, 4) | (extract_bits(payload, 14, 1) << 4) | (extract_bits(payload, 22, 1) << 5);

        int r3 = extract_bits(payload, 71, 6);
        int g3 = extract_bits(payload, 51, 4) | (extract_bits(payload, 11, 1) << 4) | (extract_bits(payload, 31, 1) << 5);
        int b3 = extract_bits(payload, 12, 2) | (extract_bits(payload, 23, 1) << 2) |
                (extract_bits(payload, 32, 1) << 3) | (extract_bits(payload, 34, 1) << 4) | (extract_bits(payload, 33, 1) << 5);

        ep0 = ivec3(r2, g2, b2);
        ep1 = ivec3(r3, g3, b3);
    }
    else
    {
        int r0 = extract_bits(payload, 5, 6);
        int g0 = extract_bits(payload, 15, 6);
        int b0 = extract_bits(payload, 25, 6);

        int r1 = extract_bits(payload, 35, 6);
        int g1 = extract_bits(payload, 45, 6);
        int b1 = extract_bits(payload, 55, 6);

        ep0 = ivec3(r0, g0, b0);
        ep1 = ivec3(r1, g1, b1);
    }

    ep0 = unquantize_endpoint(ep0, 6);
    ep1 = unquantize_endpoint(ep1, 6);

    int index = extract_bits(
            payload,
            max(81 + linear_pixel * 3 - int(linear_pixel > anchor_pixel), 82),
            (linear_pixel == 0 || linear_pixel == anchor_pixel) ? 2 : 3);

    int w = weight_table3[index];
    return DecodedInterpolation(ep0, ep1, w);
}

DecodedInterpolation
bc6_decode_texel(uvec4 payload, int mode, int linear_pixel, int part,
                 int anchor_pixel)
{
    if ((mode & 2) == 0)
    {
        if ((mode & 1) != 0)
            return decode_bc6_mode1(payload, linear_pixel, part, anchor_pixel);
        return decode_bc6_mode0(payload, linear_pixel, part, anchor_pixel);
    }
    switch (mode)
    {
    case 2: return decode_bc6_mode2(payload, linear_pixel, part, anchor_pixel);
    case 3: return decode_bc6_mode3(payload, linear_pixel);
    case 6: return decode_bc6_mode6(payload, linear_pixel, part, anchor_pixel);
    case 7: return decode_bc6_mode7(payload, linear_pixel);
    case 10: return decode_bc6_mode10(payload, linear_pixel, part, anchor_pixel);
    case 11: return decode_bc6_mode11(payload, linear_pixel);
    case 14: return decode_bc6_mode14(payload, linear_pixel, part, anchor_pixel);
    case 15: return decode_bc6_mode15(payload, linear_pixel);
    case 18: return decode_bc6_mode18(payload, linear_pixel, part, anchor_pixel);
    case 22: return decode_bc6_mode22(payload, linear_pixel, part, anchor_pixel);
    case 26: return decode_bc6_mode26(payload, linear_pixel, part, anchor_pixel);
    case 30: return decode_bc6_mode30(payload, linear_pixel, part, anchor_pixel);
    default: return DecodedInterpolation(ivec3(0), ivec3(0), 0);
    }
}

/* ---- ASTC HDR encoder ---- */
#define I(x) int(x)
#define U(x) uint(x)
#define F(x) float(x)
#define GLOBAL
#define CARR(type, name, n) const type name[n] = type[n](
#define CEND );
#include "panvk_bc_astc_enc.h"

void
main()
{
   uint x = gl_GlobalInvocationID.x;
   uint y = gl_GlobalInvocationID.y;
   uint z = gl_GlobalInvocationID.z;

   if (x >= registers.bw || y >= registers.bh)
      return;

   InBuf ibuf = InBuf(registers.src);
   uint iw = (z * registers.src_slice_B + y * registers.src_row_B) / 4u + x * 4u;
   uvec4 payload = uvec4(ibuf.data[iw], ibuf.data[iw + 1u], ibuf.data[iw + 2u],
                         ibuf.data[iw + 3u]);

   is_signed = XC_MODE == 9u;
   int mode = extract_bits(payload, 0, 5);
   int part_index = extract_bits(payload, 77, 5);
   int anchor_pixel = anchor_table2[part_index];

   for (int p = 0; p < 16; p++) {
      int part = (partition_table2[part_index] >> p) & 1;
      ivec3 rgb = interpolate_endpoint(
         bc6_decode_texel(payload, mode, p, part, anchor_pixel));
      /* Same "squeeze" as the exact decoder: fp16 bits of the texel
       * (SF16: positive half only, negatives clamp to 0). */
      if (XC_MODE == 9u)
         rgb = (max(rgb, ivec3(0)) * 31) >> 5;
      else
         rgb = (rgb * 31) >> 6;
      g_h[3 * p] = rgb.r;
      g_h[3 * p + 1] = rgb.g;
      g_h[3 * p + 2] = rgb.b;
   }

   astc_encode_block();

   /* U-interleaved, as in panvk_bc_etc2.comp (16-byte blocks). */
   uint bx = registers.bx0 + x, by = registers.by0 + y;
   uint ix = bx & 3u, iy = by & 3u;
   uint in_tile = ((iy >> 1) << 3) | (((ix ^ iy) >> 1) << 2) |
                  ((iy & 1u) << 1) | ((ix ^ iy) & 1u);
   uint ow = (z * registers.dst_slice_B + (by >> 2) * registers.dst_row_B) / 4u +
             ((bx >> 2) * 16u + in_tile) * 4u;

   OutBuf obuf = OutBuf(registers.dst);
   obuf.data[ow] = g_blk[0];
   obuf.data[ow + 1u] = g_blk[1];
   obuf.data[ow + 2u] = g_blk[2];
   obuf.data[ow + 3u] = g_blk[3];
}
